---
import '../styles/global.css';

interface Props {
  lang: 'zh-CN' | 'en' | 'zh-TW';
  title: string;
  description: string;
  path: string;
}

const { lang, title, description, path } = Astro.props;

// Basic link helper
const getPath = (targetPath: string, targetLang: string) => {
  if (targetLang === 'zh-CN') return targetPath;
  return `/${targetLang}${targetPath}`;
};
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · ChineseMusic.AI</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
  <link rel="apple-touch-icon" href="/images/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="bg-[#030712] text-slate-200 font-sans min-h-screen flex flex-col antialiased selection:bg-blue-500/30 selection:text-blue-200">
  <!-- Navbar -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-[#030712]/90 backdrop-blur-xl border-b border-slate-800/80">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href={getPath('/', lang)} class="flex items-center gap-3 group">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-9 h-9 rounded-full object-cover border border-blue-500/40 shadow-md group-hover:scale-105 transition-transform" />
        <div class="flex flex-col">
          <span class="font-bold text-sm tracking-tight text-slate-100 leading-none">ChineseMusic.AI</span>
          <span class="text-[10px] text-slate-400 mt-1 font-medium">首届北美华人AI音乐大赛</span>
        </div>
      </a>
      
      <!-- Language Switcher -->
      <div class="flex items-center bg-slate-900 border border-slate-800 rounded-full p-1 text-xs font-semibold">
        <a href="/" class={`px-3 py-1 rounded-full transition-all ${lang === 'zh-CN' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'}`}>简</a>
        <a href="/zh-TW" class={`px-3 py-1 rounded-full transition-all ${lang === 'zh-TW' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'}`}>繁</a>
        <a href="/en" class={`px-3 py-1 rounded-full transition-all ${lang === 'en' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'}`}>EN</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-grow pt-24 pb-16 relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-blue-900/10 via-purple-900/5 to-transparent pointer-events-none -z-10 blur-3xl"></div>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-[#020617] border-t border-slate-800/80 py-10 mt-auto">
    <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 text-slate-400 text-xs">
      <div class="space-y-1.5 leading-relaxed">
        <p class="text-slate-300 font-medium">© 2026 ChineseMusic.AI. All rights reserved. · <a href={getPath('/privacy', lang)} class="text-slate-400 hover:text-blue-400 underline transition-colors">{lang === 'en' ? 'Privacy Policy' : lang === 'zh-TW' ? '隱私政策' : '隐私政策'}</a></p>
        <p>联合主办：北卡浙大校友会 (ZJUAA NC)、北加高校联盟 (NACUAA NC) & 唯爱AI公益基金会 (VI AI for Good) | 501(c)(3) 免税支持 (VI AI Foundation)</p>
        <p class="text-slate-500">Domains: <a href="https://chinesemusic.ai" class="hover:text-blue-400 transition-colors">chinesemusic.ai</a> · <a href="https://music.zjuaanc.org" class="hover:text-blue-400 transition-colors">music.zjuaanc.org</a> · <a href="https://music.nacuaanc.org" class="hover:text-blue-400 transition-colors">music.nacuaanc.org</a></p>
      </div>
      <div class="flex gap-x-6 text-slate-400 font-medium shrink-0">
        <a href="https://zjuaanc.org" target="_blank" class="hover:text-blue-400 transition-colors">ZJUAA NC</a>
        <a href="https://nacuaanc.org" target="_blank" class="hover:text-blue-400 transition-colors">NACUAA NC</a>
        <a href="https://viaiforgood.org" target="_blank" class="hover:text-blue-400 transition-colors">VI AI for Good</a>
      </div>
    </div>
  </footer>
</body>
</html>
