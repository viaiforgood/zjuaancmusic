---
import '../styles/global.css';

interface Props {
  lang: 'zh-CN' | 'en' | 'zh-TW' | 'es' | 'fr' | 'ja' | 'ko' | 'vi';
  title: string;
  description: string;
  path: string;
}

const { lang, title, description, path } = Astro.props;

// Basic link helper
const getPath = (targetPath: string, targetLang: string) => {
  if (targetLang === 'zh-CN') return targetPath;
  return `/${targetLang}${targetPath}`;
};

const getCleanRoute = (p: string) => {
  if (!p) return '/';
  const cleaned = p.replace(/^\/(zh-TW|en|es|fr|ja|ko|vi)(\/|$)/, '/');
  return cleaned === '' ? '/' : cleaned;
};

const getLangSwitchUrl = (targetLang: string) => {
  const cleanRoute = getCleanRoute(path);
  if (cleanRoute === '/admin') return '/admin';
  if (targetLang === 'zh-CN') {
    return cleanRoute;
  }
  return cleanRoute === '/' ? `/${targetLang}` : `/${targetLang}${cleanRoute}`;
};

const getSubtitle = (currentLang: string) => {
  switch (currentLang) {
    case 'zh-TW': return '首屆北美AI華樂創作大賽';
    case 'en': return '1st North American AI Chinese Music Creation Contest';
    case 'es': return '1.er Concurso Norteamericano de Creación Musical China con IA';
    case 'fr': return '1er Concours Nord-Américain de Création Musicale Chinoise avec IA';
    case 'ja': return '第1回 北米 AI 華楽創作コンテスト';
    case 'ko': return '제1회 북미 AI 화악 창작 대회';
    case 'vi': return 'Cuộc thi Sáng tác Âm nhạc Trung Hoa & AI Bắc Mỹ Lần thứ 1';
    default: return '首届北美AI华乐创作大赛';
  }
};

const getPrivacyText = (currentLang: string) => {
  switch (currentLang) {
    case 'zh-TW': return '隱私政策';
    case 'en': return 'Privacy Policy';
    case 'es': return 'Política de Privacidad';
    case 'fr': return 'Politique de Confidentialité';
    case 'ja': return 'プライバシーポリシー';
    case 'ko': return '개인정보처리방침';
    case 'vi': return 'Chính sách Quyền riêng tư';
    default: return '隐私政策';
  }
};
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · ChineseMusic.AI</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
  <link rel="apple-touch-icon" href="/images/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="bg-[#030712] text-slate-200 font-sans min-h-screen flex flex-col antialiased selection:bg-blue-500/30 selection:text-blue-200">
  <!-- Navbar -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-[#030712]/90 backdrop-blur-xl border-b border-slate-800/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
      <a href={getPath('/', lang)} class="flex items-center gap-3 group shrink-0">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-9 h-9 rounded-full object-cover border border-blue-500/40 shadow-md group-hover:scale-105 transition-transform" />
        <div class="flex flex-col">
          <span class="font-bold text-sm tracking-tight text-slate-100 leading-none">ChineseMusic.AI</span>
          <span class="text-[10px] text-slate-400 mt-1 font-medium hidden sm:inline">{getSubtitle(lang)}</span>
        </div>
      </a>
      
      <!-- Compact Language Dropdown -->
      <div class="relative flex items-center bg-slate-900/90 border border-slate-700/80 hover:border-slate-600 rounded-full px-2.5 py-1 text-xs text-slate-200 gap-1.5 shadow-sm transition-colors group shrink-0">
        <i class="fa-solid fa-globe text-blue-400 text-xs pointer-events-none shrink-0"></i>
        <select
          aria-label="Language Selector"
          class="bg-transparent text-slate-200 text-xs font-medium cursor-pointer focus:outline-none appearance-none pr-3.5"
          onchange="window.location.href = this.value"
        >
          <option value={getLangSwitchUrl('zh-CN')} selected={lang === 'zh-CN'} class="bg-[#0f172a] text-slate-200">简体中文</option>
          <option value={getLangSwitchUrl('zh-TW')} selected={lang === 'zh-TW'} class="bg-[#0f172a] text-slate-200">繁體中文</option>
          <option value={getLangSwitchUrl('en')} selected={lang === 'en'} class="bg-[#0f172a] text-slate-200">English</option>
          <option value={getLangSwitchUrl('es')} selected={lang === 'es'} class="bg-[#0f172a] text-slate-200">Español</option>
          <option value={getLangSwitchUrl('fr')} selected={lang === 'fr'} class="bg-[#0f172a] text-slate-200">Français</option>
          <option value={getLangSwitchUrl('ja')} selected={lang === 'ja'} class="bg-[#0f172a] text-slate-200">日本語</option>
          <option value={getLangSwitchUrl('ko')} selected={lang === 'ko'} class="bg-[#0f172a] text-slate-200">한국어</option>
          <option value={getLangSwitchUrl('vi')} selected={lang === 'vi'} class="bg-[#0f172a] text-slate-200">Tiếng Việt</option>
        </select>
        <i class="fa-solid fa-chevron-down text-[9px] text-slate-400 group-hover:text-slate-200 pointer-events-none -ml-2.5 shrink-0"></i>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-grow pt-24 pb-16 relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-blue-900/10 via-purple-900/5 to-transparent pointer-events-none -z-10 blur-3xl"></div>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-[#020617] border-t border-slate-800/80 py-10 mt-auto">
    <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 text-slate-400 text-xs">
      <div class="space-y-1.5 leading-relaxed">
        <p class="text-slate-300 font-medium">© 2026 ChineseMusic.AI. All rights reserved. · <a href={getPath('/privacy', lang)} class="text-slate-400 hover:text-blue-400 underline transition-colors">{getPrivacyText(lang)}</a></p>
        <p>联合主办：北卡浙大校友会 (ZJUAA NC)、北加高校联盟 (NACUAA NorCal) & 唯爱AI公益基金会 (VI AI for Good) | 501(c)(3) 支持 (VI AI for Good Foundation)</p>
      </div>
      <div class="flex gap-x-6 text-slate-400 font-medium shrink-0">
        <a href="https://zjuaanc.org" target="_blank" class="hover:text-blue-400 transition-colors">ZJUAA NC</a>
        <a href="https://norcal.nacuaa.ai" target="_blank" class="hover:text-blue-400 transition-colors">NACUAA NorCal</a>
        <a href="https://viaiforgood.org" target="_blank" class="hover:text-blue-400 transition-colors">VI AI for Good</a>
      </div>
    </div>
  </footer>
</body>
</html>
