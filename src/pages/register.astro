---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-CN" title="报名表 · 首届北美华人AI音乐创作创意大赛 2026–2027" description="首届北美华人AI音乐创作创意大赛官方报名表。在线提交AI音乐与MV作品信息。" path="/register">
  <div class="max-w-3xl mx-auto px-6 py-4">
    
    <!-- Title & Intro Header -->
    <header class="text-center space-y-3 mb-8">
      <div class="inline-flex items-center gap-x-2 bg-blue-950/40 text-blue-400 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-900/30">
        <i class="fa-solid fa-music"></i>
        <span>首届北美华人AI音乐创作创意大赛 · 官方报名</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-slate-100">
        大赛作品报名表
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">
        以AI为笔，谱写华人故事 · 特别致敬浙江大学130周年华诞
      </p>
    </header>

    <!-- Multi-Step Container Card -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 md:p-10 shadow-2xl backdrop-blur-xl relative">
      
      <!-- Progress Bar Tracker -->
      <div id="progress-bar-container" class="mb-8">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-3">
          <span id="step-indicator">第 1 步 / 共 5 步：基本资料</span>
          <span id="progress-percent" class="text-blue-400 font-mono">20%</span>
        </div>
        <div class="w-full bg-slate-950 rounded-full h-2 overflow-hidden border border-slate-800">
          <div id="progress-bar" class="bg-gradient-to-r from-blue-500 to-indigo-500 h-full rounded-full transition-all duration-500" style="width: 20%;"></div>
        </div>
      </div>

      <!-- Registration Form -->
      <form id="registration-form" onsubmit="return false;" class="space-y-8">
        
        <!-- STEP 1: 基本资料 (Basic Info) -->
        <div id="step-1" class="step-content space-y-6">
          <h2 class="text-xl font-bold text-slate-100 border-b border-slate-800 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-user text-blue-400"></i>
            <span>第1步：基本资料 / Basic Information</span>
          </h2>
          
          <div class="grid sm:grid-cols-2 gap-5">
            <!-- 姓名 (Name) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-slate-300">
                姓名 / Full Name <span class="text-red-400">*</span>
              </label>
              <input type="text" id="name" name="name" required placeholder="例如：张伟" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
            </div>

            <!-- 英文名 (English Name) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-slate-300">
                英文名 / English Name <span class="text-slate-500 font-normal">(选填)</span>
              </label>
              <input type="text" id="english_name" name="english_name" placeholder="例如：David Zhang" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
            </div>

            <!-- 邮箱 (Email) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-slate-300">
                邮箱 / Email Address <span class="text-red-400">*</span>
              </label>
              <input type="email" id="email" name="email" required placeholder="your.email@example.com" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
            </div>

            <!-- 微信 (WeChat) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-slate-300">
                微信 / WeChat ID <span class="text-slate-500 font-normal">(方便入群联络)</span>
              </label>
              <input type="text" id="wechat" name="wechat" placeholder="微信账号" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
            </div>

            <!-- 手机号 (Phone) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-slate-300">
                手机号 / Phone Number <span class="text-slate-500 font-normal">(选填)</span>
              </label>
              <input type="tel" id="phone" name="phone" placeholder="+1 (123) 456-7890" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
            </div>

            <!-- 所在城市 (City) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-slate-300">
                所在城市 / City <span class="text-red-400">*</span>
              </label>
              <input type="text" id="city" name="city" required placeholder="例如：San Jose, CA / Raleigh, NC" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
            </div>
          </div>

          <!-- 所在赛区 (Hub Selection) -->
          <div class="space-y-1.5 pt-2">
            <label class="block text-xs font-bold text-slate-300">
              所在赛区 / Region Hub <span class="text-red-400">*</span>
            </label>
            <select id="hub" name="hub" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors">
              <option value="">-- 请选择所属赛区 / Select Hub --</option>
              <option value="NC">北卡赛区 (NC - North Carolina Hub)</option>
              <option value="DC">华府赛区 (DC - Greater Washington DC Hub)</option>
              <option value="TN">田纳西赛区 (TN - Tennessee Hub)</option>
              <option value="FL">佛州赛区 (FL - Florida Hub)</option>
              <option value="PA">宾州赛区 (PA - Pennsylvania Hub)</option>
              <option value="TX">德州赛区 (TX - Texas Hub)</option>
              <option value="CA">加州赛区 (CA - California Hub)</option>
              <option value="WA">华州赛区 (WA - Washington Hub)</option>
            </select>
          </div>
        </div>

        <!-- STEP 2: 参赛身份 (Participation Identity) -->
        <div id="step-2" class="step-content space-y-6 hidden">
          <h2 class="text-xl font-bold text-slate-100 border-b border-slate-800 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-users text-blue-400"></i>
            <span>第2步：参赛身份 / Participant Identity</span>
          </h2>

          <!-- 参赛类型 (Individual vs Team) -->
          <div class="space-y-2">
            <label class="block text-xs font-bold text-slate-300">参赛类型 / Submission Category <span class="text-red-400">*</span></label>
            <div class="grid grid-cols-2 gap-4">
              <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/50 transition-colors">
                <input type="radio" name="participant_type" value="individual" checked onchange="toggleTeamName(false)" class="text-blue-500" />
                <span class="text-sm font-semibold text-slate-200">个人参赛 (Individual)</span>
              </label>
              <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/50 transition-colors">
                <input type="radio" name="participant_type" value="team" onchange="toggleTeamName(true)" class="text-blue-500" />
                <span class="text-sm font-semibold text-slate-200">团队参赛 (Team)</span>
              </label>
            </div>
          </div>

          <!-- 团队名称 (Team Name - Conditional) -->
          <div id="team-name-container" class="space-y-1.5 hidden">
            <label class="block text-xs font-bold text-slate-300">
              团队名称 / Team Name <span class="text-red-400">*</span>
            </label>
            <input type="text" id="team_name" name="team_name" placeholder="请输入团队名称或乐队名" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
          </div>

          <!-- 浙大校友/亲友 (ZJU Affiliated) -->
          <div class="space-y-2">
            <label class="block text-xs font-bold text-slate-300">
              是否为浙江大学校友或亲友？/ Are you a ZJU Alumni or Friend? <span class="text-red-400">*</span>
            </label>
            <div class="grid grid-cols-2 gap-4">
              <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/50 transition-colors">
                <input type="radio" name="is_zju_affiliated" value="yes" checked class="text-blue-500" />
                <span class="text-sm font-semibold text-slate-200">是 (Yes - 校友/亲友)</span>
              </label>
              <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/50 transition-colors">
                <input type="radio" name="is_zju_affiliated" value="no" class="text-blue-500" />
                <span class="text-sm font-semibold text-slate-200">否 (No - 华人社区朋友)</span>
              </label>
            </div>
            <p class="text-[11px] text-slate-400 italic">注：大赛面向全北美华人开放，非浙大校友同样完全具备同等参赛及获奖资格。</p>
          </div>

          <!-- 简短自我介绍 (Bio) -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-300">
              简短自我介绍 / Short Bio <span class="text-slate-500 font-normal">(选填，建议100字以内)</span>
            </label>
            <textarea id="bio" name="bio" rows="3" placeholder="例如：硅谷软件工程师，业余AI音乐创作爱好者..." class="w-full bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors resize-none"></textarea>
          </div>
        </div>

        <!-- STEP 3: 参赛类别 (Categories) -->
        <div id="step-3" class="step-content space-y-6 hidden">
          <h2 class="text-xl font-bold text-slate-100 border-b border-slate-800 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-layer-group text-blue-400"></i>
            <span>第3步：参赛类别 / Competition Categories</span>
          </h2>
          <p class="text-xs text-slate-400 leading-relaxed">
            请勾选作品所涵盖或参与角逐的创作方向（可多选）：
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="诗词创作" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">📜 诗词创作 (Poetry)</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="歌词创作" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">✍️ 歌词创作 (Lyrics)</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="曲谱作曲" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">🎼 曲谱作曲 (Composition)</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="编曲制作" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">🎛️ 编曲制作 (Arranging)</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="人声演唱" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">🎤 人声演唱 (Vocal)</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="清唱 / A Cappella" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">🎶 清唱 / A Cappella</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="器乐演奏" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">🎻 器乐演奏 (Instrumental)</span>
            </label>
            <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/40 transition-colors">
              <input type="checkbox" name="categories" value="音乐视频 / MV 制作" class="rounded text-blue-500 bg-slate-900 border-slate-700 w-4 h-4" />
              <span class="text-sm font-semibold text-slate-200">🎬 音乐视频 / MV 制作</span>
            </label>
          </div>
        </div>

        <!-- STEP 4: 作品资讯 (Submission Details) -->
        <div id="step-4" class="step-content space-y-6 hidden">
          <h2 class="text-xl font-bold text-slate-100 border-b border-slate-800 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-link text-blue-400"></i>
            <span>第4步：作品资讯 / Work Information</span>
          </h2>

          <!-- 作品标题 (Work Title) -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-300">
              作品标题 / Song or Work Title <span class="text-red-400">*</span>
            </label>
            <input type="text" id="work_title" name="work_title" required placeholder="例如：《硅谷的夜曲》、《梦回求是》" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
          </div>

          <!-- 作品链接 (Work URL) -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-300">
              作品链接 / Work Link (URL) <span class="text-red-400">*</span>
            </label>
            <input type="url" id="work_url" name="work_url" required placeholder="https://suno.com/... 或 YouTube / NetEase / Google Drive 链接" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors font-mono text-xs" />
            <p class="text-[11px] text-slate-400 leading-relaxed">
              💡 说明：请提供公开可访问的链接（如 Suno、Udio、网易云音乐、YouTube、Bilibili、Google Drive、Dropbox 等）。
            </p>
          </div>

          <!-- 作品简介/理念 (Concept & Description) -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-300">
              作品简介与创作理念 / Work Description & Concept <span class="text-slate-500 font-normal">(建议 100-300 字)</span>
            </label>
            <textarea id="work_concept" name="work_concept" rows="4" placeholder="请简述创作灵感、使用的AI工具（如Suno/Udio/ChatGPT）、核心传达的情感或表达的华人故事..." class="w-full bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors resize-none"></textarea>
          </div>

          <!-- 母校主题特别奖 (Alma Mater Award) -->
          <div class="space-y-2 border-t border-slate-800/80 pt-4">
            <label class="block text-xs font-bold text-slate-300">
              是否参与「母校主题特别奖」（献给浙江大学130周年）？<span class="text-red-400">*</span>
            </label>
            <div class="grid grid-cols-2 gap-4">
              <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/50 transition-colors">
                <input type="radio" name="is_alma_mater_award" value="yes" class="text-blue-500" />
                <span class="text-sm font-semibold text-slate-200">是 (Yes - 参与母校特别奖)</span>
              </label>
              <label class="flex items-center gap-3 p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl cursor-pointer hover:border-blue-500/50 transition-colors">
                <input type="radio" name="is_alma_mater_award" value="no" checked class="text-blue-500" />
                <span class="text-sm font-semibold text-slate-200">否 (No - 仅参与通用主赛道)</span>
              </label>
            </div>
          </div>

          <!-- 其他补充说明 (Additional Notes) -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-300">
              其他补充说明 / Additional Notes <span class="text-slate-500 font-normal">(选填)</span>
            </label>
            <input type="text" id="notes" name="notes" placeholder="其他需要向评审组说明的信息" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
          </div>
        </div>

        <!-- STEP 5: 确认提交 (Confirmation) -->
        <div id="step-5" class="step-content space-y-6 hidden">
          <h2 class="text-xl font-bold text-slate-100 border-b border-slate-800 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-check-circle text-blue-400"></i>
            <span>第5步：确认提交 / Final Review & Declaration</span>
          </h2>

          <!-- Summary Preview Card -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-5 space-y-3 text-xs">
            <div class="font-bold text-slate-200 border-b border-slate-900 pb-2 text-sm">📋 参赛报名信息预览</div>
            <div class="grid grid-cols-2 gap-2 text-slate-300">
              <div><span class="text-slate-500">参赛姓名：</span><span id="preview-name" class="font-semibold text-slate-200">--</span></div>
              <div><span class="text-slate-500">联系邮箱：</span><span id="preview-email" class="font-semibold text-slate-200">--</span></div>
              <div><span class="text-slate-500">参赛赛区：</span><span id="preview-hub" class="font-semibold text-slate-200">--</span></div>
              <div><span class="text-slate-500">参赛类型：</span><span id="preview-type" class="font-semibold text-slate-200">--</span></div>
              <div class="col-span-2"><span class="text-slate-500">作品标题：</span><span id="preview-work-title" class="font-bold text-blue-400">--</span></div>
              <div class="col-span-2 truncate"><span class="text-slate-500">作品链接：</span><span id="preview-work-url" class="font-mono text-slate-400">--</span></div>
            </div>
          </div>

          <!-- Originality Declaration & Agreement Checkbox -->
          <div class="space-y-3 pt-2">
            <label class="flex items-start gap-3 p-4 bg-blue-950/20 border border-blue-900/30 rounded-2xl cursor-pointer hover:bg-blue-950/30 transition-colors">
              <input type="checkbox" id="agreed" name="agreed" required class="rounded text-blue-500 bg-slate-900 border-slate-700 w-5 h-5 mt-0.5" />
              <div class="text-xs text-slate-300 leading-relaxed">
                <span class="font-bold text-slate-100">我已阅读并同意大赛规则与原创声明 <span class="text-red-400">*</span></span><br />
                本人/团队保证提交作品为合规合法辅助创作，不侵犯第三方著作权及知识产权，授权大赛组委会用于评审展示。
              </div>
            </label>
          </div>
        </div>

        <!-- Action Navigation Buttons -->
        <div class="flex items-center justify-between pt-6 border-t border-slate-800">
          <button type="button" id="btn-prev" onclick="changeStep(-1)" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-all hidden">
            <i class="fa-solid fa-arrow-left mr-1.5"></i> 上一步 / Back
          </button>
          <div class="ml-auto flex items-center gap-3">
            <button type="button" id="btn-next" onclick="changeStep(1)" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition-all shadow-lg hover:scale-105">
              下一步 / Next <i class="fa-solid fa-arrow-right ml-1.5"></i>
            </button>
            <button type="button" id="btn-submit" onclick="submitForm()" class="px-8 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm transition-all shadow-xl hover:scale-105 hidden">
              <i class="fa-solid fa-paper-plane mr-2"></i> 提交报名 / Submit
            </button>
          </div>
        </div>

      </form>

      <!-- SUCCESS SUBMISSION SCREEN -->
      <div id="success-screen" class="space-y-6 text-center py-8 hidden">
        <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto border border-emerald-500/30 text-2xl">
          <i class="fa-solid fa-check animate-bounce"></i>
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-100">感谢您的报名！</h2>
          <p class="text-sm text-slate-400 max-w-md mx-auto leading-relaxed">
            我们已成功收到您的作品资讯。大赛组委会将在初赛海选阶段审核通知结果。
          </p>
        </div>
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 max-w-sm mx-auto font-mono text-xs text-blue-400">
          报名凭证号 / Ref ID: <span id="success-ref-id" class="font-bold text-white">CM2026-XXXXXXXX</span>
        </div>
        <div class="text-xs text-slate-500 space-y-1">
          <p>如有任何疑问，请联系组委会：</p>
          <p class="text-slate-400"><a href="mailto:info@chinesemusic.ai" class="text-blue-400 hover:underline">info@chinesemusic.ai</a> / <a href="mailto:michael@chinesemusic.ai" class="text-blue-400 hover:underline">michael@chinesemusic.ai</a></p>
        </div>
        <div class="pt-4">
          <a href="/" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-bold text-xs inline-block transition-all">
            返回大赛首页 / Back to Home
          </a>
        </div>
      </div>

    </div>

  </div>

  <script is:inline>
    let currentStep = 1;
    const totalSteps = 5;

    function updateStepUI() {
      // Hide all step contents
      for (let i = 1; i <= totalSteps; i++) {
        const el = document.getElementById(`step-${i}`);
        if (el) el.classList.add('hidden');
      }
      // Show current step
      const currentEl = document.getElementById(`step-${currentStep}`);
      if (currentEl) currentEl.classList.remove('hidden');

      // Update progress indicator
      const progressPercent = Math.round((currentStep / totalSteps) * 100);
      const progressBar = document.getElementById('progress-bar');
      const progressText = document.getElementById('progress-percent');
      const stepIndicator = document.getElementById('step-indicator');

      const stepTitles = [
        '基本资料 / Basic Info',
        '参赛身份 / Identity',
        '参赛类别 / Categories',
        '作品资讯 / Submission Details',
        '确认提交 / Confirmation'
      ];

      if (progressBar) progressBar.style.width = `${progressPercent}%`;
      if (progressText) progressText.innerText = `${progressPercent}%`;
      if (stepIndicator) stepIndicator.innerText = `第 ${currentStep} 步 / 共 ${totalSteps} 步：${stepTitles[currentStep - 1]}`;

      // Navigation buttons control
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const btnSubmit = document.getElementById('btn-submit');

      if (currentStep === 1) {
        btnPrev.classList.add('hidden');
      } else {
        btnPrev.classList.remove('hidden');
      }

      if (currentStep === totalSteps) {
        btnNext.classList.add('hidden');
        btnSubmit.classList.remove('hidden');
        updatePreview();
      } else {
        btnNext.classList.remove('hidden');
        btnSubmit.classList.add('hidden');
      }
    }

    function toggleTeamName(isTeam) {
      const container = document.getElementById('team-name-container');
      const input = document.getElementById('team_name');
      if (isTeam) {
        container.classList.remove('hidden');
        input.setAttribute('required', 'true');
      } else {
        container.classList.add('hidden');
        input.removeAttribute('required');
      }
    }

    function validateCurrentStep() {
      if (currentStep === 1) {
        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();
        const city = document.getElementById('city').value.trim();
        const hub = document.getElementById('hub').value;
        if (!name || !email || !city || !hub) {
          alert('请填写标有 * 的必填基本资料项 (姓名、邮箱、城市、赛区)');
          return false;
        }
      } else if (currentStep === 2) {
        const isTeam = document.querySelector('input[name="participant_type"]:checked').value === 'team';
        if (isTeam) {
          const teamName = document.getElementById('team_name').value.trim();
          if (!teamName) {
            alert('请填写团队名称');
            return false;
          }
        }
      } else if (currentStep === 4) {
        const workTitle = document.getElementById('work_title').value.trim();
        const workUrl = document.getElementById('work_url').value.trim();
        if (!workTitle || !workUrl) {
          alert('请填写作品标题及公开作品链接 (URL)');
          return false;
        }
      }
      return true;
    }

    function changeStep(delta) {
      if (delta > 0 && !validateCurrentStep()) {
        return;
      }
      currentStep += delta;
      if (currentStep < 1) currentStep = 1;
      if (currentStep > totalSteps) currentStep = totalSteps;
      updateStepUI();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updatePreview() {
      document.getElementById('preview-name').innerText = document.getElementById('name').value || '--';
      document.getElementById('preview-email').innerText = document.getElementById('email').value || '--';
      document.getElementById('preview-hub').innerText = document.getElementById('hub').value || '--';
      
      const type = document.querySelector('input[name="participant_type"]:checked').value;
      document.getElementById('preview-type').innerText = type === 'team' ? `团队 (${document.getElementById('team_name').value})` : '个人';
      
      document.getElementById('preview-work-title').innerText = document.getElementById('work_title').value || '--';
      document.getElementById('preview-work-url').innerText = document.getElementById('work_url').value || '--';
    }

    async function submitForm() {
      const agreed = document.getElementById('agreed').checked;
      if (!agreed) {
        alert('请勾选同意大赛规则与原创声明');
        return;
      }

      const form = document.getElementById('registration-form');
      const formData = new FormData(form);
      
      // Selected categories array
      const selectedCategories = [];
      document.querySelectorAll('input[name="categories"]:checked').forEach((cb) => {
        selectedCategories.push(cb.value);
      });

      const payload = {
        name: formData.get('name'),
        english_name: formData.get('english_name'),
        email: formData.get('email'),
        wechat: formData.get('wechat'),
        phone: formData.get('phone'),
        city: formData.get('city'),
        hub: formData.get('hub'),
        participant_type: formData.get('participant_type'),
        team_name: formData.get('team_name'),
        is_zju_affiliated: formData.get('is_zju_affiliated'),
        bio: formData.get('bio'),
        categories: selectedCategories,
        work_title: formData.get('work_title'),
        work_url: formData.get('work_url'),
        work_concept: formData.get('work_concept'),
        is_alma_mater_award: formData.get('is_alma_mater_award'),
        notes: formData.get('notes'),
        agreed: true
      };

      const btnSubmit = document.getElementById('btn-submit');
      btnSubmit.disabled = true;
      btnSubmit.innerHTML = `<i class="fa-solid fa-spinner animate-spin mr-2"></i> 提交中...`;

      try {
        const response = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (response.ok && data.success) {
          document.getElementById('registration-form').classList.add('hidden');
          document.getElementById('progress-bar-container').classList.add('hidden');
          document.getElementById('success-ref-id').innerText = data.refId;
          document.getElementById('success-screen').classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          alert(`提交失败: ${data.error || '服务器错误'}`);
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = `<i class="fa-solid fa-paper-plane mr-2"></i> 提交报名 / Submit`;
        }
      } catch (err) {
        alert('提交遇到网络错误，请检查网络连接后重试。');
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `<i class="fa-solid fa-paper-plane mr-2"></i> 提交报名 / Submit`;
      }
    }
  </script>
</BaseLayout>
