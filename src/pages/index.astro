---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-CN" title="首届北美华人AI音乐创作创意大赛 2026–2027" description="由北卡浙大校友会 (ZJUAA NC)、北加高校联盟 (NACUAA NC) 与 唯爱AI公益基金会 (VI AI for Good) 共同主办的首届北美华人AI音乐创作创意大赛。" path="/">
  <div class="max-w-4xl mx-auto px-6 space-y-12">
    <!-- Hero -->
    <header class="text-center py-6 space-y-4 flex flex-col items-center">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full p-1 bg-gradient-to-tr from-blue-600 via-purple-500 to-amber-400 shadow-2xl shadow-blue-500/20 mb-2">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-full h-full rounded-full object-cover border-2 border-slate-950" />
      </div>
      <div class="inline-flex items-center gap-x-2 bg-blue-950/70 text-blue-300 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-500/30 shadow-inner">
        <span class="w-2 h-2 bg-blue-400 rounded-full animate-ping"></span>
        <span>以AI为笔，谱写华人故事 · 特别致敬浙江大学130周年华诞</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mt-2">
        首届北美华人AI音乐<br><span class="ai-gradient">创作创意大赛 2026–2027</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-300 text-base md:text-lg leading-relaxed">
        面向全北美华人、华裔及音乐爱好者开放。支持纯人工原创、人机协同与全流程AI创作，共同打造属于全球华人的音乐传奇。
      </p>
      <div class="pt-4 flex flex-wrap justify-center gap-3 md:gap-4">
        <a href="/register" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white font-bold transition-all shadow-lg shadow-blue-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>在线报名表 / Register Now</span>
        </a>
        <a href="https://luma.com/p9v0rz16" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold transition-all shadow-lg shadow-purple-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-video text-purple-200"></i>
          <span>8/28 Luma 线上交流会</span>
        </a>
        <a href="#details" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold transition-all hover:scale-105 shadow-sm">
          赛事详情
        </a>
      </div>
    </header>

    <!-- Hero Image Banner -->
    <div class="relative w-full h-56 md:h-80 rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900 flex items-center justify-center group">
      <img src="/images/hero.jpg" alt="AI Music Banner" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
    </div>

    <!-- Main Content Section -->
    <div id="details" class="grid md:grid-cols-3 gap-8 pt-6">
      
      <!-- Left Column: Details -->
      <div class="md:col-span-2 space-y-10">
        
        <!-- 大赛宗旨 -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-bullseye text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              大赛宗旨 / About the Contest
            </h2>
          </div>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            本大赛由 <span class="badge-blue">北卡浙大校友会 (ZJUAA NC)</span>、<span class="badge-indigo">北加高校联盟 (NACUAA NC)</span> 与 <span class="badge-purple">唯爱AI公益基金会 (VI AI for Good)</span> 共同主办，联合多个美东浙大校友会，以及北美高校联盟北加州、硅谷、南加州分会等机构共同支持。
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            这是<strong class="text-sky-400 font-bold">首届专为北美华人打造的音乐与AI创作创意大赛</strong>。大赛热忱欢迎北美广大华人华侨、留学生学者及音乐创意爱好者踊跃参与，表达华人在北美的生活故事、深厚情感、文化交融与科技创新精神。
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            大赛特设<span class="badge-gold">“母校主题特别奖”</span>，鼓励海内外校友与朋友创作献给浙江大学130周年华诞的音乐与创意作品。
          </p>
        </section>

        <!-- 参赛资格 & 作品形式 -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-id-card text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              参赛资格与作品形式 / Eligibility & Formats
            </h2>
          </div>

          <!-- 参赛资格 -->
          <div class="space-y-3">
            <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-blue-500 rounded-full"></span>
              <span>1. 参赛资格 / Eligibility</span>
            </h3>
            <div class="grid gap-2.5">
              <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800/80 text-slate-100 text-sm font-medium">
                <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
                <span>居住在北美地区的华人、华裔、留学生、学者及广大音乐创意爱好者（同时热忱欢迎全球华人与音乐友人参与）</span>
              </div>
              <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800/80 text-slate-100 text-sm font-medium">
                <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
                <span>不限年龄与职业背景；支持以个人独立参赛或团队协同创作形式参赛</span>
              </div>
            </div>
          </div>

          <!-- 创作形式全部接纳 -->
          <div class="space-y-3 pt-2">
            <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-purple-500 rounded-full"></span>
              <span>2. 音乐与作品创作形式（三类均全面接纳）/ Accepted Formats</span>
            </h3>
            <div class="grid gap-3">
              <div class="p-4 rounded-2xl bg-slate-950/80 border border-sky-900/40 space-y-1 shadow-sm">
                <div class="text-sky-300 font-bold text-sm flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-sky-950/90 border border-sky-500/40 text-xs">类别 1</span>
                  <span>纯人工原创 (No AI / Pure Human Creation)</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed pl-1">传统原创词曲创作、乐器实录演奏、人声演唱录制等不借助AI的纯人工音乐作品。</p>
              </div>

              <div class="p-4 rounded-2xl bg-slate-950/80 border border-purple-900/40 space-y-1 shadow-sm">
                <div class="text-purple-300 font-bold text-sm flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-purple-950/90 border border-purple-500/40 text-xs">类别 2</span>
                  <span>人机协同 / AI 辅助创作 (AI-Aided / Hybrid Creation)</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed pl-1">人工与 AI 深度融合（如人工写词+AI编曲/旋律生成，或AI构思+人工演唱编曲等）的协同创意作品。</p>
              </div>

              <div class="p-4 rounded-2xl bg-slate-950/80 border border-amber-900/40 space-y-1 shadow-sm">
                <div class="text-amber-300 font-bold text-sm flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-amber-950/90 border border-amber-500/40 text-xs">类别 3</span>
                  <span>全流程 AI 生成 (AIGC / Full AI Generation)</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed pl-1">借助 Suno、Udio、ChatGPT 等前沿 AI 模型完成词、曲、编、唱或 MV 的全流程端到端生成作品。</p>
              </div>
            </div>
            <p class="text-xs text-slate-400 bg-slate-950/40 p-3 rounded-xl border border-slate-800/60 leading-relaxed">
              ⚖️ <strong class="text-slate-200">公平评审原则</strong>：三种创作形式同台竞技、分类考核与综合评审，注重作品的艺术感染力、故事共鸣与创意表现。
            </p>
          </div>
        </section>

        <!-- 大赛架构 -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-sitemap text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              大赛架构 (三个阶段 · 八个赛区)
            </h2>
          </div>
          <div class="grid sm:grid-cols-3 gap-4 pt-1">
            <div class="bg-slate-950/70 border border-blue-900/40 p-4 rounded-2xl text-center space-y-2 shadow-sm">
              <div class="text-blue-400 font-extrabold text-base md:text-lg">初赛阶段</div>
              <div class="text-xs text-slate-300 leading-relaxed">全美八个分赛区（<a href="https://nc.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">北卡</a>、<a href="https://dc.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">华府</a>、<a href="https://tn.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">田纳西</a>、<a href="https://fl.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">佛州</a>、<a href="https://pa.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">宾州</a>、<a href="https://tx.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">德州</a>、<a href="https://ca.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">加州</a>、<a href="https://wa.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">华州</a>）平行海选</div>
            </div>
            <div class="bg-slate-950/70 border border-indigo-900/40 p-4 rounded-2xl text-center space-y-2 shadow-sm">
              <div class="text-indigo-400 font-extrabold text-base md:text-lg">联盟复赛</div>
              <div class="text-xs text-slate-300 leading-relaxed">东部联盟 vs 西部联盟<br>强强对决，角逐总决赛名额</div>
            </div>
            <div class="bg-slate-950/70 border border-purple-900/40 p-4 rounded-2xl text-center space-y-2 shadow-sm">
              <div class="text-purple-400 font-extrabold text-base md:text-lg">总决赛</div>
              <div class="text-xs text-slate-300 leading-relaxed">东西联盟晋级作品终极角逐，争夺前三名丰厚大奖</div>
            </div>
          </div>
        </section>

        <!-- 参赛类别与详细说明 -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-music text-lg"></i>
            </div>
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-white">
                参赛类别与创作方向 (八大创作赛道)
              </h2>
              <p class="text-xs text-slate-300 mt-0.5">涵盖纯人工、人机协同与全流程AI创作，可单项或跨界申报：</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
            
            <!-- 1. 诗词创作 -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sky-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-sky-950/80 border border-sky-500/30 flex items-center justify-center text-xs">01</span>
                  <span>📜 诗词创作 / Poetry</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">文学与格律</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>说明</strong>：涵盖律诗、绝句、古体诗、现代抒情诗、散文诗等体裁。将华人情怀、北美生活感悟或科技哲思熔铸为优美诗篇。
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> 创作示例：</div>
                <div>• 以北美秋日异乡求学或思乡为主题创作的七言律诗。</div>
                <div>• 运用 AI 大模型辅助格律校对与修辞、表达跨文化感悟的现代新诗。</div>
              </div>
            </div>

            <!-- 2. 歌词创作 -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-purple-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-purple-950/80 border border-purple-500/30 flex items-center justify-center text-xs">02</span>
                  <span>✍️ 歌词创作 / Lyrics</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">文本与叙事</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>说明</strong>：适用于流行、古风、摇滚、民谣、说唱等各流派的完整歌词。注重音节韵律、段落起承转合与叙事感染力。
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> 创作示例：</div>
                <div>• 描绘华人跨洋打拼历程与家庭温情的中英双语叙事歌词。</div>
                <div>• 融合西湖烟雨与北美红枫意象创作的中国风流行歌词。</div>
              </div>
            </div>

            <!-- 3. 曲谱作曲 -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-indigo-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-indigo-950/80 border border-indigo-500/30 flex items-center justify-center text-xs">03</span>
                  <span>🎼 曲谱作曲 / Composition</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">旋律与和声</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>说明</strong>：创作主旋律、核心音乐动机或完整曲谱。提交形式可为简谱、五线谱、MIDI 音频试听或主旋律录音 Demo。
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> 创作示例：</div>
                <div>• 融合东方五声调式与现代流行爵士和弦的动人主旋律。</div>
                <div>• 借助 AI 旋律生成工具获取动机灵感、经人工精细调整创作的主题曲。</div>
              </div>
            </div>

            <!-- 4. 编曲制作 -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-amber-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-amber-950/80 border border-amber-500/30 flex items-center justify-center text-xs">04</span>
                  <span>🎛️ 编曲制作 / Arranging</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">配器与制作</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>说明</strong>：针对旋律进行乐器配器、声音设计、节奏律动编排及混音。支持电子、管弦交响、摇滚、Lo-Fi 等多元风格。
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> 创作示例：</div>
                <div>• 将中国传统民乐（古筝、二胡、笛箫）与欧美电子律动（Future Bass）融合的编曲。</div>
                <div>• 利用 AI 分轨工具结合专业 DAW 进行高品质母带重构与混音。</div>
              </div>
            </div>

            <!-- 5. 人声演唱 -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-emerald-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center text-xs">05</span>
                  <span>🎤 人声演唱 / Vocal</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">声乐演绎</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>说明</strong>：真人歌手原声主唱、重唱或合唱录制；亦支持 AI 音色建模克隆、虚拟歌手调教或人机双重唱。
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> 创作示例：</div>
                <div>• 歌手深情投入的录音室纯真人原声主唱演绎。</div>
                <div>• 真人原声领唱与 AI 生成的宏大和声伴唱交织的创新作品。</div>
              </div>
            </div>

            <!-- 6. 清唱 / 阿卡贝拉 -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-teal-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-teal-950/80 border border-teal-500/30 flex items-center justify-center text-xs">06</span>
                  <span>🎶 清唱 / A Cappella</span>
                </div>
