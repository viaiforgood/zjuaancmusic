---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-TW" title="報名表 · 首屆北美華人AI音樂創作創意大賽 2026–2027" description="首屆北美華人AI音樂創作創意大賽官方報名表。線上提交AI音樂與MV作品資訊。" path="/zh-TW/register">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    
    <!-- Title & Intro Header -->
    <header class="text-center space-y-3">
      <div class="inline-flex items-center gap-x-2 bg-blue-950/40 text-blue-400 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-900/30">
        <i class="fa-solid fa-music"></i>
        <span>首屆北美華人AI音樂創作創意大賽 · 官方報名</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
        大賽作品報名表
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">
        以AI為筆，譜寫華人故事 · 特別致敬浙江大學130周年華誕
      </p>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a href="https://tally.so/r/aQqXGW" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-semibold text-blue-400 hover:text-blue-300 bg-blue-950/50 hover:bg-blue-950/80 px-3.5 py-1.5 rounded-lg border border-blue-900/50 transition-colors">
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          <span>在新視窗全螢幕打開表單 (Open in New Tab)</span>
        </a>
      </div>
    </header>

    <!-- Track Selection & Cap Notice with Hourly Count Tracking -->
    <div class="bg-gradient-to-r from-blue-950/60 via-purple-950/60 to-slate-900/80 border border-blue-800/60 rounded-2xl p-4 sm:p-5 text-xs text-slate-200 space-y-3">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2 font-bold text-sm text-amber-300">
          <i class="fa-solid fa-circle-info"></i>
          <span>賽道選擇與名額看板 / Tracks & Registration Stats</span>
        </div>
        <div class="inline-flex items-center gap-1.5 text-[11px] text-emerald-400 bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-800/50">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span id="stat-sync-label">每小時整點更新 (Hourly Update)</span>
        </div>
      </div>

      <!-- Timezone Indicators Bar -->
      <div class="flex items-center justify-between flex-wrap gap-2 text-[11px] text-slate-400 pt-1 pb-0.5 border-t border-slate-800/60">
        <div class="flex items-center gap-2 flex-wrap" id="stat-timezones">
          <span class="text-slate-400 font-semibold"><i class="fa-regular fa-clock text-blue-400"></i> 數據快照時間：</span>
          <span class="text-slate-200 font-mono" id="stat-time-edt">-- EDT</span>
          <span class="text-slate-600">|</span>
          <span class="text-slate-200 font-mono" id="stat-time-pdt">-- PDT</span>
          <span class="text-slate-600">|</span>
          <span class="text-slate-200 font-mono" id="stat-time-cst">-- 臺北/北京</span>
          <span class="text-slate-600">|</span>
          <span class="text-slate-400 font-mono" id="stat-time-utc">-- UTC</span>
        </div>
        <span class="text-[10px] text-slate-500">每小時自動刷新</span>
      </div>

      <div class="grid sm:grid-cols-3 gap-3 pt-1">
        <!-- North America Track Card -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-blue-900/50 space-y-2 flex flex-col justify-between shadow-sm">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-bold text-blue-300 text-xs">1. 北美主賽道</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-800/60">不設上限</span>
            </div>
            <div class="text-[11px] text-slate-400 leading-relaxed">美、加、墨主要居住/就學創作者；進入八大賽區海選、聯盟複賽與總決賽。</div>
          </div>
          <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-[11px]">
            <span class="text-slate-400">席位狀態：</span>
            <span class="font-semibold text-emerald-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>開放申報 · 席位充足</span>
            </span>
          </div>
        </div>

        <!-- Sinophone Track Card (Cap 150) -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-purple-900/50 space-y-2 flex flex-col justify-between shadow-sm">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-bold text-purple-300 text-xs">2. 華語世界賽道</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800/60" id="stat-sino-badge">試點限額 150</span>
            </div>
            <div class="text-[11px] text-slate-400 leading-relaxed">中國大陸、港澳臺及亞洲華語社區；試點開放150件，超額進入候補。</div>
          </div>
          <div class="pt-2 border-t border-slate-800/80 space-y-1.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-400">席位狀態：</span>
              <span class="font-semibold text-emerald-400 flex items-center gap-1.5" id="stat-sino-status">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>名額充裕 · 開放申報</span>
              </span>
            </div>
            <div class="w-full bg-slate-900 rounded-full h-1.5 overflow-hidden">
              <div id="stat-sino-bar" class="bg-gradient-to-r from-purple-500 to-indigo-400 h-1.5 rounded-full transition-all duration-500" style="width: 25%"></div>
            </div>
          </div>
        </div>

        <!-- International Open Track Card (Cap 80) -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-emerald-900/50 space-y-2 flex flex-col justify-between shadow-sm">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-bold text-emerald-300 text-xs">3. 國際開放賽道</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800/60" id="stat-intl-badge">試點限額 80</span>
            </div>
            <div class="text-[11px] text-slate-400 leading-relaxed">北美及華語區以外其他國家與地區；試點開放80件，超額進入候補。</div>
          </div>
          <div class="pt-2 border-t border-slate-800/80 space-y-1.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-400">席位狀態：</span>
              <span class="font-semibold text-emerald-400 flex items-center gap-1.5" id="stat-intl-status">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>名額充裕 · 開放申報</span>
              </span>
            </div>
            <div class="w-full bg-slate-900 rounded-full h-1.5 overflow-hidden">
              <div id="stat-intl-bar" class="bg-gradient-to-r from-emerald-500 to-teal-400 h-1.5 rounded-full transition-all duration-500" style="width: 25%"></div>
            </div>
          </div>
        </div>
      </div>

      <p class="text-[11px] text-slate-400 pt-1 border-t border-slate-800/60">
        ※ 資格按提交作者/團隊負責人主要居住地劃分；一人/團隊限選一條賽道；全賽道統一順延截止：<strong>2026年9月28日（農曆八月十八週一）11:59 PM EDT</strong>。嚴禁翻唱，須原創音樂。
      </p>
    </div>

    <!-- Embedded Tally Form Container (Clean High-Contrast Card matching independent page) -->
    <div class="bg-white rounded-3xl p-2 sm:p-6 shadow-2xl overflow-hidden min-h-[700px] border border-slate-700/50">
      <iframe 
        data-tally-src="https://tally.so/embed/aQqXGW?alignLeft=1&dynamicHeight=1" 
        loading="lazy" 
        width="100%" 
        height="1200" 
        frameborder="0" 
        marginheight="0" 
        marginwidth="0" 
        title="首屆北美AI華樂創作大賽 2026–2027 官方報名表"
        class="w-full rounded-2xl bg-white">
      </iframe>
    </div>

    <!-- Official Help & WeChat Info -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="space-y-1 text-center sm:text-left">
        <div class="font-bold text-slate-200 text-sm">💡 報名如有任何疑問、或需直接郵件投稿作品？</div>
        <p>可直接聯絡大賽官方投稿與諮詢郵箱：<a href="mailto:submit@chinesemusic.ai" class="text-blue-400 font-semibold hover:underline">submit@chinesemusic.ai</a></p>
      </div>
      <a href="/zh-TW" class="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold border border-slate-700 transition-colors shrink-0">
        返回首頁 / Back Home
      </a>
    </div>

  </div>

  <!-- Tally Official Embed Script -->
  <script src="https://tally.so/widgets/embed.js"></script>

  <!-- Real-Time / Dynamic Track Stats Fetcher -->
  <script is:inline>
    async function updateTrackStats() {
      try {
        const res = await fetch('/api/stats');
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !data.tracks) return;

        const sino = data.tracks.sinophone;
        const intl = data.tracks.international_open;

        // Sinophone Track (Cap 150): Hide small raw counts, only show urgency count when approaching cap (>=80% or <=30 spots)
        const sinoStatusEl = document.getElementById('stat-sino-status');
        const sinoBarEl = document.getElementById('stat-sino-bar');
        const sinoBadgeEl = document.getElementById('stat-sino-badge');
        if (sino && sinoStatusEl) {
          const cap = sino.cap || 150;
          const count = sino.count || 0;
          const remaining = Math.max(0, cap - count);

          if (sino.isWaitlist || count >= cap) {
            sinoStatusEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span><span class="text-rose-300 font-bold">已滿額 · 候補排隊中 (Waitlist)</span>';
            if (sinoBadgeEl) {
              sinoBadgeEl.textContent = '已滿額 · 候補';
              sinoBadgeEl.className = 'text-[10px] px-1.5 py-0.5 rounded bg-rose-950 text-rose-300 border border-rose-800/60 font-bold';
            }
            if (sinoBarEl) sinoBarEl.style.width = '100%';
          } else if (remaining <= 30 || count >= cap * 0.8) {
            sinoStatusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span><span class="text-amber-300 font-bold">席位緊張 · 僅剩 ${remaining} 席</span>`;
            if (sinoBadgeEl) {
              sinoBadgeEl.textContent = `僅剩 ${remaining} 席`;
              sinoBadgeEl.className = 'text-[10px] px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800/60 font-bold';
            }
            if (sinoBarEl) sinoBarEl.style.width = `${Math.min(100, Math.round((count / cap) * 100))}%`;
          } else {
            // Far from limit: show positive abundance status without revealing small raw number
            sinoStatusEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-emerald-400 font-semibold">名額充裕 · 開放申報</span>';
            if (sinoBadgeEl) {
              sinoBadgeEl.textContent = '試點限額 150';
              sinoBadgeEl.className = 'text-[10px] px-1.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800/60';
            }
            if (sinoBarEl) sinoBarEl.style.width = '25%';
          }
        }

        // International Open Track (Cap 80): Hide small raw counts, only show urgency count when approaching cap (>=80% or <=20 spots)
        const intlStatusEl = document.getElementById('stat-intl-status');
        const intlBarEl = document.getElementById('stat-intl-bar');
        const intlBadgeEl = document.getElementById('stat-intl-badge');
        if (intl && intlStatusEl) {
          const cap = intl.cap || 80;
          const count = intl.count || 0;
          const remaining = Math.max(0, cap - count);

          if (intl.isWaitlist || count >= cap) {
            intlStatusEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span><span class="text-rose-300 font-bold">已滿額 · 候補排隊中 (Waitlist)</span>';
            if (intlBadgeEl) {
              intlBadgeEl.textContent = '已滿額 · 候補';
              intlBadgeEl.className = 'text-[10px] px-1.5 py-0.5 rounded bg-rose-950 text-rose-300 border border-rose-800/60 font-bold';
            }
            if (intlBarEl) intlBarEl.style.width = '100%';
          } else if (remaining <= 20 || count >= cap * 0.8) {
            intlStatusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span><span class="text-amber-300 font-bold">席位緊張 · 僅剩 ${remaining} 席</span>`;
            if (intlBadgeEl) {
              intlBadgeEl.textContent = `僅剩 ${remaining} 席`;
              intlBadgeEl.className = 'text-[10px] px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800/60 font-bold';
            }
            if (intlBarEl) intlBarEl.style.width = `${Math.min(100, Math.round((count / cap) * 100))}%`;
          } else {
            // Far from limit: show positive abundance status without revealing small raw number
            intlStatusEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-emerald-400 font-semibold">名額充裕 · 開放申報</span>';
            if (intlBadgeEl) {
              intlBadgeEl.textContent = '試點限額 80';
              intlBadgeEl.className = 'text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800/60';
            }
            if (intlBarEl) intlBarEl.style.width = '25%';
          }
        }

        // Update Multi-Timezone Snapshot Timestamps
        if (data.updatedTimes) {
          const edtEl = document.getElementById('stat-time-edt');
          const pdtEl = document.getElementById('stat-time-pdt');
          const cstEl = document.getElementById('stat-time-cst');
          const utcEl = document.getElementById('stat-time-utc');
          if (edtEl && data.updatedTimes.edt) edtEl.textContent = data.updatedTimes.edt;
          if (pdtEl && data.updatedTimes.pdt) pdtEl.textContent = data.updatedTimes.pdt;
          if (cstEl && data.updatedTimes.beijing) cstEl.textContent = data.updatedTimes.beijing;
          if (utcEl && data.updatedTimes.utc) utcEl.textContent = data.updatedTimes.utc;
        }
      } catch (e) {
        // Silent fallback
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateTrackStats);
    } else {
      updateTrackStats();
    }
    // Update every hour (3600,000 ms)
    setInterval(updateTrackStats, 3600000);
  </script>
</BaseLayout>
