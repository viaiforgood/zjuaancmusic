---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-TW" title="報名表 · 首屆北美華人AI音樂創作創意大賽 2026–2027" description="首屆北美華人AI音樂創作創意大賽官方報名表。線上提交AI音樂與MV作品資訊。" path="/zh-TW/register">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    
    <!-- Title & Intro Header -->
    <header class="text-center space-y-3">
      <div class="inline-flex items-center gap-x-2 bg-blue-950/40 text-blue-400 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-900/30">
        <i class="fa-solid fa-music"></i>
        <span>首屆北美華人AI音樂創作創意大賽 · 官方報名</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
        大賽作品報名表
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">
        以AI為筆，譜寫華人故事 · 特別致敬浙江大學130周年華誕
      </p>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a href="https://tally.so/r/aQqXGW" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-semibold text-blue-400 hover:text-blue-300 bg-blue-950/50 hover:bg-blue-950/80 px-3.5 py-1.5 rounded-lg border border-blue-900/50 transition-colors">
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          <span>在新視窗全螢幕打開表單 (Open in New Tab)</span>
        </a>
      </div>
    </header>

    <!-- Embedded Tally Form Container -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-4 sm:p-8 shadow-2xl backdrop-blur-xl relative overflow-hidden min-h-[600px]">
      <iframe 
        data-tally-src="https://tally.so/embed/aQqXGW?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" 
        loading="lazy" 
        width="100%" 
        height="1200" 
        frameborder="0" 
        marginheight="0" 
        marginwidth="0" 
        title="首屆北美華人AI音樂創作創意大賽 2026–2027 官方報名表"
        class="w-full rounded-2xl bg-transparent">
      </iframe>
    </div>

    <!-- Official Help Info -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="space-y-1 text-center sm:text-left">
        <div class="font-bold text-slate-200 text-sm">💡 報名如有任何疑問或需要協助？</div>
        <p>可直接聯絡大賽官方信箱：<a href="mailto:info@chinesemusic.ai" class="text-blue-400 hover:underline">info@chinesemusic.ai</a> / <a href="mailto:michael@chinesemusic.ai" class="text-blue-400 hover:underline">michael@chinesemusic.ai</a></p>
      </div>
      <a href="/zh-TW" class="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold border border-slate-700 transition-colors shrink-0">
        返回首頁 / Back Home
      </a>
    </div>

  </div>

  <!-- Tally Official Embed Script -->
  <script src="https://tally.so/widgets/embed.js"></script>
</BaseLayout>
