---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="fr" title="1er Concours Nord-Américain de Création Musicale Chinoise avec IA 2026–2027" description="1er Concours Nord-Américain de Création Musicale Chinoise avec IA, co-organisé par la Fondation VI AI for Good, ZJUAA NC et NACUAA NorCal." path="/fr">
  <div class="max-w-4xl mx-auto px-6 space-y-12">
    <!-- Hero -->
    <header class="text-center py-6 space-y-4 flex flex-col items-center">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full p-1 bg-gradient-to-tr from-blue-600 via-purple-500 to-amber-400 shadow-2xl shadow-blue-500/20 mb-2">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-full h-full rounded-full object-cover border-2 border-slate-950" />
      </div>
      <div class="inline-flex items-center gap-x-2 bg-blue-950/70 text-blue-300 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-500/30 shadow-inner">
        <span class="w-2 h-2 bg-blue-400 rounded-full animate-ping"></span>
        <span>Œuvres originales inédites · Reprises strictement interdites · Hommage au 130e Anniversaire de ZJU</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mt-2">
        1er Concours Nord-Américain de<br><span class="ai-gradient">Création Musicale Chinoise avec IA 2026–2027</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-300 text-base md:text-lg leading-relaxed">
        Ouvert à tous les musiciens, créateurs et étudiants en Amérique du Nord (États-Unis, Canada, Mexique). Créations strictement originales et inédites ; les reprises (covers) sont formellement exclues.
      </p>
      <div class="pt-4 flex flex-wrap justify-center gap-3 md:gap-4">
        <a href="https://music.weiai.ai" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold transition-all shadow-lg shadow-purple-600/30 hover:scale-105 flex items-center gap-2 border border-purple-400/50">
          <i class="fa-solid fa-graduation-cap text-lg"></i>
          <span>Académie de Musique VI AI (music.weiai.ai)</span>
        </a>
        <a href="/fr/register" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white font-bold transition-all shadow-lg shadow-blue-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Formulaire d'Inscription</span>
        </a>
        <a href="https://youtu.be/KE3NJB6791Y" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold transition-all shadow-lg shadow-red-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-brands fa-youtube text-lg"></i>
          <span>Voir le Replay du Lancement</span>
        </a>
        <a href="#docs" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold transition-all hover:scale-105 shadow-sm flex items-center gap-2">
          <i class="fa-solid fa-file-pdf text-emerald-400"></i>
          <span>Télécharger le Livre Blanc</span>
        </a>
      </div>
    </header>

    <!-- Hero Image Banner -->
    <div class="relative w-full h-56 md:h-80 rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900 flex items-center justify-center group">
      <img src="/images/hero.jpg" alt="AI Music Banner" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
    </div>

    <!-- Main Content Section -->
    <div id="details" class="grid md:grid-cols-3 gap-8 pt-6">
      
      <!-- Left Column: Details -->
      <div class="md:col-span-2 space-y-10">
        
        <!-- About the Contest -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-bullseye text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              Mission du Concours / 大赛宗旨
            </h2>
          </div>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            Ce concours est co-organisé par la <span class="badge-purple">Fondation VI AI for Good</span>, <span class="badge-blue">ZJUAA NC</span> et <span class="badge-indigo">NACUAA NorCal</span>, avec le soutien d'associations d'anciens élèves et de partenaires culturels en Amérique du Nord.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            Il s'agit du <strong class="text-sky-400 font-bold">1er Concours Nord-Américain de Création Musicale Chinoise avec IA</strong>. Nous invitons tous les créateurs d'Amérique du Nord (toutes origines bienvenues) à explorer la rencontre entre le patrimoine musical chinois et l'IA générative. <strong class="text-amber-300">Réservé exclusivement aux créations musicales et chansons originales inédites ; les reprises de morceaux existants sont strictement interdites</strong>.
          </p>
        </section>

        <!-- The 3 Tracks -->
        <section class="space-y-4">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-shapes text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              Trois Voies de Création / 三大赛道
            </h2>
          </div>
          <div class="grid sm:grid-cols-3 gap-4">
            <!-- Track 1 -->
            <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2 hover:border-sky-500/50 transition-colors">
              <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">Track 01</span>
              <h3 class="text-base font-bold text-white">100% Original Humain</h3>
              <p class="text-xs text-slate-300 leading-relaxed">Composition, paroles et instruments acoustiques 100% humains. Zéro recours à l'IA.</p>
            </div>
            <!-- Track 2 -->
            <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2 hover:border-purple-500/50 transition-colors">
              <span class="text-xs font-bold text-purple-400 uppercase tracking-wider">Track 02</span>
              <h3 class="text-base font-bold text-white">Co-création Humain + IA</h3>
              <p class="text-xs text-slate-300 leading-relaxed">Interprétation vocale et textes humains combinés aux mélodies et arrangements assistés par IA.</p>
            </div>
            <!-- Track 3 -->
            <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2 hover:border-amber-500/50 transition-colors">
              <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Track 03</span>
              <h3 class="text-base font-bold text-white">AIGC Intégrale</h3>
              <p class="text-xs text-slate-300 leading-relaxed">Génération musicale complète de bout en bout avec Suno, Udio, ChatGPT et modèles d'IA.</p>
            </div>
          </div>
        </section>

        <!-- 8 Disciplines -->
        <section class="space-y-4">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-compact-disc text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              Huit Disciplines Professionnelles / 八大专业方向
            </h2>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-pen-nib text-blue-400"></i><span>Poésie Classique (Classical Poetry)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-feather text-indigo-400"></i><span>Paroles Modernes (Modern Lyrics)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-music text-purple-400"></i><span>Composition Musicale (Composition)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-sliders text-emerald-400"></i><span>Arrangement & Production (Arrangement)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-microphone text-amber-400"></i><span>Chant de Chanson Originale (Vocals)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-users text-rose-400"></i><span>Chœur & A Cappella (Ensemble & Choir)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-guitar text-teal-400"></i><span>Musique Instrumentale (Instrumental)</span></div>
            <div class="p-3.5 rounded-xl bg-slate-900/70 border border-slate-800 font-semibold text-slate-200 flex items-center gap-2"><i class="fa-solid fa-film text-cyan-400"></i><span>Clip Vidéo Musical (Music Video MV)</span></div>
          </div>
        </section>

        <!-- Download Materials -->
        <section id="docs" class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-file-arrow-down text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              Official Downloads / 官方物料下载
            </h2>
          </div>
          <div class="grid sm:grid-cols-2 gap-3 pt-2 text-xs">
            <a href="/docs/ChineseMusic_AI_Official_Poster_Bilingual.pdf" target="_blank" class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-blue-500/50 flex items-center justify-between transition-all">
              <div class="flex items-center gap-3">
                <i class="fa-solid fa-file-pdf text-red-400 text-lg"></i>
                <div>
                  <div class="text-white font-bold">Official Poster (PDF)</div>
                  <div class="text-slate-400 text-[11px]">18" x 24" Vector Print Ready</div>
                </div>
              </div>
              <i class="fa-solid fa-download text-slate-400"></i>
            </a>
            <a href="/docs/ChineseMusic_AI_Official_Handout_Bilingual.pdf" target="_blank" class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-blue-500/50 flex items-center justify-between transition-all">
              <div class="flex items-center gap-3">
                <i class="fa-solid fa-file-pdf text-red-400 text-lg"></i>
                <div>
                  <div class="text-white font-bold">Official Handout (PDF)</div>
                  <div class="text-slate-400 text-[11px]">8.5" x 11" 2-Page Duplex</div>
                </div>
              </div>
              <i class="fa-solid fa-download text-slate-400"></i>
            </a>
          </div>
        </section>

      </div>

      <!-- Right Column: Sidebar -->
      <div class="space-y-8">
        
        <!-- Registration Card -->
        <div class="bg-gradient-to-br from-blue-950/60 to-slate-900 border border-blue-800/40 rounded-3xl p-6 space-y-4 shadow-xl text-center">
          <div class="w-12 h-12 rounded-2xl bg-blue-600/30 border border-blue-500/40 flex items-center justify-center text-blue-400 mx-auto text-xl">
            <i class="fa-solid fa-qrcode"></i>
          </div>
          <h3 class="text-lg font-bold text-white">Join the Contest</h3>
          <p class="text-xs text-slate-300">Submit your original tracks before September 28, 2026.</p>
          <img src="/images/register_qr.png" alt="Register QR" class="w-36 h-36 mx-auto rounded-xl bg-white p-2 border border-slate-700" />
          <a href="/fr/register" class="w-full py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-colors inline-block shadow-md">
            Formulaire d'Inscription
          </a>
        </div>

        <!-- Key Dates -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 space-y-3 shadow-xl">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-calendar-days text-blue-400"></i>
            <span>Calendrier et Jalons / 赛程时间表</span>
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-300">
              <strong class="text-amber-400 block mb-1">Sep 28, 2026 · 11:59 PM EDT</strong>
              <span>Clôture des soumissions : 28 septembre 2026 à 23h59 EDT</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-300">
              <strong class="text-sky-400 block mb-1">Sep 30, 2026</strong>
              <span>Hommage spécial ZJU : 30 septembre 2026</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-300">
              <strong class="text-purple-400 block mb-1">Feb 27, 2027</strong>
              <span>Grande Finale Mondiale : 27 février 2027</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
