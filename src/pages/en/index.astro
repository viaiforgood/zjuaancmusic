---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="1st North America Chinese AI Music & Creativity Contest 2026–2027" description="The 1st North America Chinese AI Music Creation & Creativity Contest, co-hosted by ZJUAA NC and NACUAA NC." path="/">
  <div class="max-w-4xl mx-auto px-6 space-y-12">
    <!-- Hero -->
    <header class="text-center py-6 space-y-4 flex flex-col items-center">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full p-1 bg-gradient-to-tr from-blue-600 via-purple-500 to-amber-400 shadow-2xl shadow-blue-500/20 mb-2">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-full h-full rounded-full object-cover border-2 border-slate-950" />
      </div>
      <div class="inline-flex items-center gap-x-2 bg-blue-950/70 text-blue-300 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-500/30 shadow-inner">
        <span class="w-2 h-2 bg-blue-400 rounded-full animate-ping"></span>
        <span>Composing Chinese Stories with AI · Dedicated to ZJU's 130th Anniversary</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mt-2">
        1st North America Chinese<br><span class="ai-gradient">AI Music Contest 2026–2027</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-300 text-base md:text-lg leading-relaxed">
        Open to all Chinese diaspora and music creators across North America. Welcoming Pure Human Original, AI-Assisted, and Full AIGC music creations.
      </p>
      <div class="pt-4 flex flex-wrap justify-center gap-3 md:gap-4">
        <a href="/en/register" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white font-bold transition-all shadow-lg shadow-blue-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Online Registration Form</span>
        </a>
        <a href="https://luma.com/p9v0rz16" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold transition-all shadow-lg shadow-purple-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-video text-purple-200"></i>
          <span>8/28 Luma Kickoff (Zoom)</span>
        </a>
        <a href="#details" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold transition-all hover:scale-105 shadow-sm">
          Contest Details
        </a>
      </div>
    </header>

    <!-- Hero Image Banner -->
    <div class="relative w-full h-56 md:h-80 rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900 flex items-center justify-center group">
      <img src="/images/hero.jpg" alt="AI Music Banner" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
    </div>

    <!-- Main Content Section -->
    <div id="details" class="grid md:grid-cols-3 gap-8 pt-6">
      
      <!-- Left Column: Details -->
      <div class="md:col-span-2 space-y-10">
        
        <!-- About the Contest -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-bullseye text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              About the Contest / 大赛宗旨
            </h2>
          </div>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            This competition is co-hosted by <span class="badge-blue">ZJU Alumni Association of NC (ZJUAA NC)</span> and <span class="badge-indigo">Chinese University Alumni Alliance of NC (NACUAA NC)</span>, supported by multiple US East ZJU alumni associations, as well as NACUAA chapters in Northern California, Silicon Valley, Southern California, and other partner organizations.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            This is the <strong class="text-sky-400 font-bold">1st Music and AI Creativity Contest built specifically for the Chinese diaspora in North America</strong>. We warmly invite Chinese residents, immigrants, international students, scholars, and music enthusiasts across North America to participate, expressing the stories, emotions, cultural fusion, and innovation of the Chinese community.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            A dedicated <span class="badge-gold">"Special Alma Mater Award"</span> is also established to honor Zhejiang University's 130th Anniversary.
          </p>
        </section>

        <!-- Eligibility & Formats -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-id-card text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              Eligibility & Accepted Formats / 参赛资格与作品形式
            </h2>
          </div>

          <!-- Eligibility -->
          <div class="space-y-3">
            <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-blue-500 rounded-full"></span>
              <span>1. Participant Eligibility</span>
            </h3>
            <div class="grid gap-2.5">
              <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800/80 text-slate-100 text-sm font-medium">
                <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
                <span>Open to all Chinese diaspora, residents, students, scholars, and music creators living in North America (and warmly welcoming global participants and friends worldwide).</span>
              </div>
              <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800/80 text-slate-100 text-sm font-medium">
                <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
                <span>No age limits; individual solo creators or collaborative team entries are both welcomed.</span>
              </div>
            </div>
          </div>

          <!-- Accepted Creation Formats -->
          <div class="space-y-3 pt-2">
            <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-purple-500 rounded-full"></span>
              <span>2. Accepted Music & Creation Formats (All 3 Tiers Accepted)</span>
            </h3>
            <div class="grid gap-3">
              <div class="p-4 rounded-2xl bg-slate-950/80 border border-sky-900/40 space-y-1 shadow-sm">
                <div class="text-sky-300 font-bold text-sm flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-sky-950/90 border border-sky-500/40 text-xs">Tier 1</span>
                  <span>Pure Human Original (No AI)</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed pl-1">Traditional original songwriting, lyric writing, instrumental recordings, live vocals, and acoustic performances created without AI.</p>
              </div>

              <div class="p-4 rounded-2xl bg-slate-950/80 border border-purple-900/40 space-y-1 shadow-sm">
                <div class="text-purple-300 font-bold text-sm flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-purple-950/90 border border-purple-500/40 text-xs">Tier 2</span>
                  <span>AI-Assisted / Hybrid Creation (AI-Aided)</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed pl-1">Deep human-AI co-creation (e.g., human lyrics + AI arrangement/melody, or AI inspiration + human live vocal performance and mixing).</p>
              </div>

              <div class="p-4 rounded-2xl bg-slate-950/80 border border-amber-900/40 space-y-1 shadow-sm">
                <div class="text-amber-300 font-bold text-sm flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-amber-950/90 border border-amber-500/40 text-xs">Tier 3</span>
                  <span>Full AI Generation (AIGC)</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed pl-1">End-to-end AI music and MV generation leveraging cutting-edge models such as Suno, Udio, ChatGPT, etc.</p>
              </div>
            </div>
            <p class="text-xs text-slate-400 bg-slate-950/40 p-3 rounded-xl border border-slate-800/60 leading-relaxed">
              ⚖️ <strong class="text-slate-200">Fair & Balanced Judging</strong>: All three creation formats compete on an equal stage with balanced evaluation criteria focusing on artistic impact, storytelling resonance, and creative excellence.
            </p>
          </div>
        </section>

        <!-- Structure -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-sitemap text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              Contest Structure (3 Stages · 8 Hubs)
            </h2>
          </div>
          <div class="grid sm:grid-cols-3 gap-4 pt-1">
            <div class="bg-slate-950/70 border border-blue-900/40 p-4 rounded-2xl text-center space-y-2 shadow-sm">
              <div class="text-blue-400 font-extrabold text-base md:text-lg">Preliminaries</div>
              <div class="text-xs text-slate-300 leading-relaxed">Auditions across 8 hubs (<a href="https://nc.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">NC</a>, <a href="https://dc.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">DC</a>, <a href="https://tn.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">TN</a>, <a href="https://fl.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">FL</a>, <a href="https://pa.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">PA</a>, <a href="https://tx.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">TX</a>, <a href="https://ca.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">CA</a>, <a href="https://wa.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">WA</a>)</div>
            </div>
            <div class="bg-slate-950/70 border border-indigo-900/40 p-4 rounded-2xl text-center space-y-2 shadow-sm">
              <div class="text-indigo-400 font-extrabold text-base md:text-lg">Semifinals</div>
              <div class="text-xs text-slate-300 leading-relaxed">East Alliance vs West Alliance in a major digital showdown.</div>
            </div>
            <div class="bg-slate-950/70 border border-purple-900/40 p-4 rounded-2xl text-center space-y-2 shadow-sm">
              <div class="text-purple-400 font-extrabold text-base md:text-lg">Grand Finals</div>
              <div class="text-xs text-slate-300 leading-relaxed">Finalists from both alliances compete for top grand awards.</div>
            </div>
          </div>
        </section>

        <!-- Categories & Detailed Explanations -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-music text-lg"></i>
            </div>
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-white">
                Contest Categories & Disciplines (8 Tracks)
              </h2>
              <p class="text-xs text-slate-300 mt-0.5">Welcoming Pure Human, AI-Assisted, and Full AIGC submissions across single or cross-disciplinary entries:</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
            
            <!-- 1. Poetry Writing -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sky-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-sky-950/80 border border-sky-500/30 flex items-center justify-center text-xs">01</span>
                  <span>📜 Poetry Writing / 诗词创作</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Literature & Verse</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Classical regulated verse (Lüshi/Jueju), ancient poetry, modern lyrical poetry, and prose poetry capturing diaspora life, reflections, and emotions.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Seven-character classical verse themed on studying in North America or nostalgia.</div>
                <div>• Modern free verse crafted with AI LLM rhyming assistance exploring cross-cultural identity.</div>
              </div>
            </div>

            <!-- 2. Lyrics Writing -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-purple-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-purple-950/80 border border-purple-500/30 flex items-center justify-center text-xs">02</span>
                  <span>✍️ Lyrics Writing / 歌词创作</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Song Lyrics & Story</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Complete lyrics across Pop, Chinese Style (Guofeng), Rock, Folk, R&B, Rap, etc., emphasizing metric cadence, chorus hooks, and resonant storytelling.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Bilingual narrative lyrics chronicling immigrant journeys and generational memories.</div>
                <div>• Poetic Chinese Guofeng pop lyrics blending Eastern imagery with North American landscapes.</div>
              </div>
            </div>

            <!-- 3. Composition -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-indigo-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-indigo-950/80 border border-indigo-500/30 flex items-center justify-center text-xs">03</span>
                  <span>🎼 Composition / 曲谱作曲</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Melody & Harmony</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Writing original melodic motifs, chord progressions, and full sheet music. Submissions accepted as numbered musical notation, staff notation, MIDI, or audio demos.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Touching melody combining traditional pentatonic scales with contemporary jazz harmonies.</div>
                <div>• Catchy pop hook developed from AI-generated melodic seeds and refined by human composers.</div>
              </div>
            </div>

            <!-- 4. Arranging & Production -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-amber-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-amber-950/80 border border-amber-500/30 flex items-center justify-center text-xs">04</span>
                  <span>🎛️ Arranging & Production / 编曲制作</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Instrumentation & Mix</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Orchestration, sound design, rhythm programming, and mixing across Electronic, Symphonic, Rock, Lo-Fi, and Fusion styles.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• East-meets-West arrangement fusing traditional instruments (Guzheng, Erhu) with Future Bass EDM.</div>
                <div>• AI stems split and remastered with professional DAW layering and hybrid audio engineering.</div>
              </div>
            </div>

            <!-- 5. Vocals -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-emerald-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center text-xs">05</span>
                  <span>🎤 Vocals / 人声演唱</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Vocal Performance</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Studio vocal recordings, solos, duets, or choirs; also accepts AI voice cloning, virtual singer synthesis (ACE Studio/Vocaloid), and human-AI duets.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Soulful acoustic lead vocal performance recorded live in studio.</div>
                <div>• Human live lead vocal soaring over epic AI-generated choir harmonizations.</div>
              </div>
            </div>

            <!-- 6. A Cappella -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-teal-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-teal-950/80 border border-teal-500/30 flex items-center justify-center text-xs">06</span>
                  <span>🎶 A Cappella / 清唱</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Pure Voice Art</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Music composed entirely of human vocal tracks without conventional instruments, including multi-part vocal ensembles, solo a cappella, and vocal percussion (Beatbox).
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Multi-harmony vocal arrangement of classic university anthems or original lyrical ballads.</div>
                <div>• Innovative a cappella combining human beatbox rhythms with layered vocal synth emulations.</div>
              </div>
            </div>

            <!-- 7. Instrumental -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-rose-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-rose-950/80 border border-rose-500/30 flex items-center justify-center text-xs">07</span>
                  <span>🎻 Instrumental / 器乐演奏</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Instrument Solo & Ensemble</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Solo, ensemble, chamber, or concerto performances on Western or Chinese instruments (Piano, Guitar, Violin, Guzheng, Pipa, Erhu, etc.) and synthesizers.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Piano and Erhu cross-cultural instrumental dialogue piece.</div>
                <div>• Original acoustic fingerstyle guitar solo or fully live-recorded string quartet.</div>
              </div>
            </div>

            <!-- 8. Music Video / MV -->
            <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl p-4 space-y-2.5 hover:border-purple-500/40 transition-colors shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-yellow-300 font-bold text-sm">
                  <span class="w-7 h-7 rounded-lg bg-yellow-950/80 border border-yellow-500/30 flex items-center justify-center text-xs">08</span>
                  <span>🎬 Music Video (MV) / 音乐视频</span>
                </div>
                <span class="text-[11px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">Audio-Visual Art</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                <strong>Scope</strong>: Comprehensive audiovisual artworks combining music with live-action cinematography, AI video generation (Runway, Kling, Midjourney, Sora), or 3D animations.
              </p>
              <div class="bg-slate-900/70 p-2.5 rounded-xl border border-slate-800/80 text-[11px] text-slate-300 space-y-1">
                <div class="text-slate-400 font-semibold flex items-center gap-1"><i class="fa-solid fa-lightbulb text-amber-400 text-[10px]"></i> Creative Examples:</div>
                <div>• Epic conceptual MV depicting "Eastern Sci-Fi & Diaspora Legends" generated with AI visual models.</div>
                <div>• Documentary-style live-action video capturing the daily life, warmth, and stories of North American Chinese families.</div>
              </div>
            </div>

          </div>
        </section>

        <!-- Special Awards -->
