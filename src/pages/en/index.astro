---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="1st North American AI Chinese Music Creation Contest 2026–2027" description="The 1st North American AI Chinese Music Creation Contest, co-hosted by VI AI for Good Foundation, ZJUAA NC, and NACUAA NorCal." path="/">
  <div class="max-w-4xl mx-auto px-6 space-y-12">
    <!-- Hero -->
    <header class="text-center py-6 space-y-4 flex flex-col items-center">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full p-1 bg-gradient-to-tr from-blue-600 via-purple-500 to-amber-400 shadow-2xl shadow-blue-500/20 mb-2">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-full h-full rounded-full object-cover border-2 border-slate-950" />
      </div>
      <div class="inline-flex items-center gap-x-2 bg-blue-950/70 text-blue-300 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-500/30 shadow-inner">
        <span class="w-2 h-2 bg-blue-400 rounded-full animate-ping"></span>
        <span>Call for Original Works · Brand New Songs Only (No Covers) · Honoring ZJU 130th Anniversary</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mt-2">
        1st North American AI Chinese<br><span class="ai-gradient">Music Creation Contest 2026–2027</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-300 text-base md:text-lg leading-relaxed">
        Open to all musicians, scholars, students, and creators across North America (all backgrounds welcome), celebrating Chinese musical culture with AI. <strong class="text-amber-300">Brand new original songs and compositions only; covers of existing songs are strictly prohibited</strong>.
      </p>
      <div class="pt-4 flex flex-wrap justify-center gap-3 md:gap-4">
        <a href="https://music.weiai.ai" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold transition-all shadow-lg shadow-purple-600/30 hover:scale-105 flex items-center gap-2 border border-purple-400/50">
          <i class="fa-solid fa-graduation-cap text-lg"></i>
          <span>VI AI Music Academy (music.weiai.ai)</span>
        </a>
        <a href="/en/register" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white font-bold transition-all shadow-lg shadow-blue-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Online Registration Form</span>
        </a>
        <a href="https://youtu.be/KE3NJB6791Y" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold transition-all shadow-lg shadow-red-600/30 hover:scale-105 flex items-center gap-2">
          <i class="fa-brands fa-youtube text-lg"></i>
          <span>Watch Kickoff Full Replay</span>
        </a>
        <a href="#docs" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold transition-all hover:scale-105 shadow-sm flex items-center gap-2">
          <i class="fa-solid fa-file-pdf text-emerald-400"></i>
          <span>Download Guides & Briefs</span>
        </a>
      </div>
    </header>

    <!-- Hero Image Banner -->
    <div class="relative w-full h-56 md:h-80 rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900 flex items-center justify-center group">
      <img src="/images/hero.jpg" alt="AI Music Banner" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
    </div>

    <!-- Main Content Section -->
    <div id="details" class="grid md:grid-cols-3 gap-8 pt-6">
      
      <!-- Left Column: Details -->
      <div class="md:col-span-2 space-y-10">
        
        <!-- About the Contest -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-bullseye text-lg"></i>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white">
              About the Contest / 大赛宗旨
            </h2>
          </div>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            This competition is co-hosted by <span class="badge-purple">VI AI for Good Foundation</span>, <span class="badge-blue">ZJU Alumni Association of NC (ZJUAA NC)</span>, and <span class="badge-indigo">Chinese University Alumni Alliance of NC (NACUAA NorCal)</span>, supported by ZJU alumni associations in Tennessee, Philadelphia, Rhode Island, Florida, as well as NACUAA chapters in Northern California, Silicon Valley, Southern California, North Carolina, Washington DC, and other partner organizations.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            This is the <strong class="text-sky-400 font-bold">1st North American AI Chinese Music Creation Contest</strong>. While anchored in North America, this edition introduces two pilot tracks: the <strong>Sinophone Track (cap 150)</strong> and the <strong>International Open Track (cap 80)</strong>. We warmly invite creators, scholars, and innovators worldwide to participate (track placement is based on primary residence, not ethnicity), exploring Chinese musical heritage with AI. <strong class="text-amber-300">Original works only; covers of existing songs are strictly prohibited</strong>.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            The contest features a <span class="badge-gold">"Special Alma Mater Tribute Award"</span> honoring Zhejiang University's 130th Anniversary (May 21, 2027).
          </p>
        </section>

        <!-- 📢 News & Announcements -->
        <section id="news" class="bg-gradient-to-br from-blue-950/40 via-slate-900/90 to-purple-950/40 border border-blue-900/40 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm">
          <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div class="flex items-center gap-x-3">
              <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0 shadow-sm">
                <i class="fa-solid fa-bullhorn text-lg"></i>
              </div>
              <div>
                <h2 class="text-xl md:text-2xl font-bold text-white">
                  News & Official Announcements
                </h2>
                <p class="text-xs text-slate-400">Track latest competition milestones, briefings, and schedules</p>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <!-- Announcement Card: Deadline Extension -->
            <div class="p-5 md:p-6 rounded-2xl bg-gradient-to-r from-blue-950/90 via-indigo-950/80 to-purple-950/90 border-2 border-amber-400/80 space-y-3 hover:border-amber-300 transition-all shadow-xl relative overflow-hidden">
              <div class="absolute -right-8 -top-8 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="px-3 py-1 rounded-full bg-gradient-to-r from-amber-500/30 to-orange-500/30 text-amber-300 text-xs font-bold border border-amber-500/50 shadow-sm flex items-center gap-1.5">
                  <i class="fa-solid fa-clock-rotate-left"></i> Official Notice · Deadline Extension
                </span>
                <span class="text-xs text-amber-300/80 font-mono font-semibold">Published Sep 13, 2026</span>
              </div>
              <h3 class="text-lg md:text-xl font-bold text-white tracking-tight flex items-center gap-2 flex-wrap">
                <span>[Important Notice] Unified Submission Deadline Extended to September 28, 2026 (Mon)!</span>
                <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-normal">Festive Inspiration & Fast AI Review</span>
              </h3>
              <div class="text-xs md:text-sm text-slate-200 leading-relaxed space-y-2">
                <p>
                  In response to enthusiastic requests from participants and creators seeking more time to refine their entries, polish lyrics, and fine-tune AI audio arrangements over upcoming weekends—and to draw inspiration from the warmth and cultural richness of the approaching Mid-Autumn Festival (农历中秋佳节)—the Organizing Committee has decided to extend the contest entry deadline!
                </p>
                <p>
                  Meanwhile, our engineering team has deployed a major upgrade to the underlying <strong>AI-Agent Automated Review & Compliance Screening System</strong>. The upgraded multi-agent review system operates around the clock to perform multimodal audio checks, copyright pre-screening, formatting verification, and acoustic analysis at unprecedented speeds, significantly shortening the preliminary judging turnaround time.
                </p>
                <p class="bg-slate-900/80 rounded-xl p-3 border border-amber-500/30 text-amber-200 font-medium">
                  🌟 <strong>Updated Schedule</strong>: The unified submission deadline across all tracks (North America Main Track, Sinophone Track, International Open Track, and ZJU 130th Tribute Award) is extended to:<br>
                  <span class="text-white font-bold text-sm md:text-base">👉 Monday, September 28, 2026 (Lunar Aug 18) at 11:59 PM EDT / 8:59 PM PDT</span><br>
                  <span class="text-slate-300 text-xs mt-1 inline-block">Preliminary advancement results and shortlists will be announced promptly on <strong>Wednesday, September 30, 2026</strong>.</span>
                </p>
              </div>
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <a href="/en/register" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 text-xs font-bold shadow-md transition-all">
                  <i class="fa-solid fa-file-pen text-[11px]"></i> Polish & Submit Your Entry Now
                </a>
                <a href="#dates" class="text-xs text-blue-400 hover:text-blue-300 hover:underline inline-flex items-center gap-1">
                  <i class="fa-solid fa-calendar-days"></i> View Updated Key Dates →
                </a>
              </div>
            </div>

            <!-- Announcement Card: New Pilot Tracks -->
            <div class="p-5 rounded-2xl bg-gradient-to-r from-blue-950/80 via-slate-950/90 to-purple-950/80 border border-amber-500/50 space-y-2 hover:border-amber-400 transition-all shadow-lg">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold border border-amber-500/40">
                  <i class="fa-solid fa-bullhorn mr-1"></i> New Pilot Tracks Announcement
                </span>
                <span class="text-xs text-slate-400 font-mono">Sep 2026</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white">
                [New Tracks] Sinophone & International Open Pilot Tracks Now Open (Cap 150 / 80)
              </h3>
              <p class="text-xs md:text-sm text-slate-300 leading-relaxed">
                In response to enthusiastic interest from creators outside North America, the contest has introduced two pilot tracks under the main contest banner:
                <br>• <strong>Sinophone Track (Pilot · Cap 150 entries)</strong>
                <br>• <strong>International Open Track (Pilot · Cap 80 entries)</strong>
                <br>Contest brand name remains unchanged. Unified submission deadline: <strong>September 28, 2026 (Lunar Aug 18) at 11:59 PM EDT</strong>.
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <a href="/en/register" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs font-bold shadow-md transition-all">
                  <i class="fa-solid fa-file-pen text-[10px]"></i> Register Now Online
                </a>
                <a href="#eligibility" class="text-xs text-blue-400 hover:underline">View Eligibility Rules →</a>
              </div>
            </div>

            <!-- News Item 1 -->
            <div class="p-5 rounded-2xl bg-slate-950/70 border border-blue-900/50 space-y-2 hover:border-blue-500/50 transition-all">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="px-2.5 py-1 rounded-full bg-blue-900/60 text-blue-300 text-xs font-bold border border-blue-700/40">
                  <i class="fa-solid fa-sparkles mr-1"></i> Latest Release
                </span>
                <span class="text-xs text-slate-400 font-mono">Aug 28, 2026</span>
              </div>
              <h3 class="text-base font-bold text-white">
                [Kickoff Complete] Contest Launched: 2 Live Replay Videos + 3 Gemini Notebook Media Published
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                On Aug 28, 2026 at 1:00 PM PDT, the official contest launch & creator meetup was successfully held. The committee has released the complete whitepaper, kickoff briefing, 2 original live videos, and 3 Google Gemini NotebookLM deep-dive discussions on YouTube!
              </p>
              <div class="pt-2 flex flex-wrap gap-3 text-xs">
                <a href="https://youtu.be/KE3NJB6791Y" target="_blank" class="text-red-400 hover:text-red-300 font-bold inline-flex items-center gap-1">
                  <i class="fa-brands fa-youtube"></i> Watch Full Recording
                </a>
                <span class="text-slate-600">·</span>
                <a href="https://www.youtube.com/playlist?list=PLGkKw_qoWmuo" target="_blank" class="text-red-400 hover:text-red-300 font-bold inline-flex items-center gap-1">
                  <i class="fa-solid fa-list"></i> YouTube 5-Video Playlist
                </a>
                <span class="text-slate-600">·</span>
                <a href="#docs" class="text-emerald-400 hover:text-emerald-300 font-semibold inline-flex items-center gap-1">
                  <i class="fa-solid fa-file-arrow-down"></i> Download Whitepapers
                </a>
              </div>
            </div>

            <!-- News Item 2 -->
            <div class="p-5 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-2 hover:border-slate-700 transition-all">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="px-2.5 py-1 rounded-full bg-amber-950/60 text-amber-300 text-xs font-bold border border-amber-700/40">
                  <i class="fa-solid fa-award mr-1"></i> Special Tribute Award
                </span>
                <span class="text-xs text-slate-400 font-mono">August 2026</span>
              </div>
              <h3 class="text-base font-bold text-white">
                Zhejiang University 130th Anniversary Global Song Campaign
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Dedicated to Zhejiang University's 130th Anniversary (May 21, 2027), the submission deadline for the Special Tribute Award is unified on <strong>September 28, 2026 (Lunar Aug 18) at 11:59 PM EDT</strong>. Outstanding entries will be directly recommended on <strong>September 30</strong> to the Zhejiang University Alumni Association global showcase.
              </p>
              <div class="pt-1">
                <a href="https://m.thepaper.cn/newsDetail_forward_33388625" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 font-semibold text-xs inline-flex items-center gap-1">
                  <span>View Official University Notice (The Paper)</span>
                  <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                </a>
              </div>
            </div>

          </div>
        </section>

        <!-- 🎙️ Video & Media Sessions (2 Live Videos + 3 Gemini Notebook Discussions) -->
        <section id="media" class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm">
          <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div class="flex items-center gap-x-3">
              <div class="w-10 h-10 rounded-xl bg-red-500/20 border border-red-500/40 flex items-center justify-center text-red-400 shrink-0 shadow-sm">
                <i class="fa-brands fa-youtube text-lg"></i>
              </div>
              <div>
                <h2 class="text-xl md:text-2xl font-bold text-white">
                  Kickoff Video Replay & Topics
                </h2>
                <p class="text-xs text-slate-400">2 Original Live Session Videos + 3 Google Gemini NotebookLM Discussions</p>
              </div>
            </div>
            <a href="https://www.youtube.com/playlist?list=PLGkKw_qoWmuo" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 text-xs text-red-400 hover:text-red-300 font-bold bg-red-950/40 px-3 py-1.5 rounded-lg border border-red-900/50">
              <i class="fa-solid fa-list-ul"></i> YouTube Playlist (5 Videos)
            </a>
          </div>

          <!-- YouTube Embed Video Card -->
          <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 shadow-2xl space-y-3">
            <div class="relative w-full pb-[56.25%] h-0">
              <iframe 
                src="https://www.youtube-nocookie.com/embed/KE3NJB6791Y" 
                title="1st North American Chinese AI Music Contest Launch Session Full Replay" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen 
                class="absolute top-0 left-0 w-full h-full">
              </iframe>
            </div>
            <div class="p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-slate-950">
              <div>
                <div class="text-sm font-bold text-white flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-red-950 text-red-400 border border-red-800/40 text-xs font-semibold">Live Video 1</span>
                  <span>1st North American Chinese AI Music Contest Kickoff Full Recording</span>
                </div>
                <div class="text-xs text-slate-400 mt-0.5">Aug 28 Live Broadcast · Rule breakdowns, AI workflow demos, and Q&A</div>
              </div>
              <div class="flex gap-2 shrink-0">
                <a href="https://youtu.be/KE3NJB6791Y" target="_blank" class="px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs transition-colors flex items-center gap-1.5">
                  <i class="fa-brands fa-youtube"></i> Watch on YouTube
                </a>
                <a href="https://www.youtube.com/playlist?list=PLGkKw_qoWmuo" target="_blank" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-colors flex items-center gap-1.5">
                  <i class="fa-solid fa-list"></i> Playlist
                </a>
              </div>
            </div>
          </div>

          <!-- 3 Gemini Notebook Audio Converted Videos -->
          <div class="space-y-3 pt-2">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
                <i class="fa-solid fa-robot text-purple-400"></i>
                <span>3 Deep-Dive Discussions Generated by Gemini Notebook</span>
              </h3>
              <span class="text-xs text-slate-500">All available in YouTube Playlist</span>
            </div>
            
            <!-- Topic 1 -->
            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-blue-500/40 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400 shrink-0 font-bold">
                  01
                </div>
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <h4 class="text-sm font-bold text-white">"Reshaping Chinese AI Music with Emotion"</h4>
                    <span class="text-[11px] px-1.5 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/40">Gemini</span>
                  </div>
                  <p class="text-xs text-slate-400">Centering authentic human stories and emotions in the age of algorithmic creation (11m 46s)</p>
                </div>
              </div>
              <div class="flex gap-2 shrink-0">
                <a href="https://www.youtube.com/playlist?list=PLGkKw_qoWmuo" target="_blank" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-blue-300 font-bold text-xs border border-slate-700 transition-colors flex items-center gap-1.5">
                  <i class="fa-brands fa-youtube text-red-400"></i> Listen Session
                </a>
              </div>
            </div>

            <!-- Topic 2 -->
            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-purple-500/40 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-400 shrink-0 font-bold">
                  02
                </div>
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <h4 class="text-sm font-bold text-white">"Singing North American Chinese Stories with AI"</h4>
                    <span class="text-[11px] px-1.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800/40">Gemini</span>
                  </div>
                  <p class="text-xs text-slate-400">Capturing immigrant memories, entrepreneurship, and diaspora journeys in music (20m 41s)</p>
                </div>
              </div>
              <div class="flex gap-2 shrink-0">
                <a href="https://www.youtube.com/playlist?list=PLGkKw_qoWmuo" target="_blank" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-purple-300 font-bold text-xs border border-slate-700 transition-colors flex items-center gap-1.5">
                  <i class="fa-brands fa-youtube text-red-400"></i> Listen Session
                </a>
              </div>
            </div>

            <!-- Topic 3 -->
            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-emerald-500/40 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 font-bold">
                  03
                </div>
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <h4 class="text-sm font-bold text-white">"Is it Fair for Humans and AI to Share the Stage?"</h4>
                    <span class="text-[11px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800/40">Gemini</span>
                  </div>
                  <p class="text-xs text-slate-400">Comprehensive breakdown of No-AI, Hybrid, and Full-AIGC category evaluation ethics (20m 30s)</p>
                </div>
              </div>
              <div class="flex gap-2 shrink-0">
                <a href="https://www.youtube.com/playlist?list=PLGkKw_qoWmuo" target="_blank" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-300 font-bold text-xs border border-slate-700 transition-colors flex items-center gap-1.5">
                  <i class="fa-brands fa-youtube text-red-400"></i> Listen Session
                </a>
              </div>
            </div>

          </div>
        </section>

        <!-- 📥 Documents & Guides Download -->
        <section id="docs" class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0 shadow-sm">
              <i class="fa-solid fa-file-pdf text-lg"></i>
            </div>
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-white">
                Official Documents & Guides Download
              </h2>
              <p class="text-xs text-slate-400">One-click downloads for whitepapers, kickoff briefing, and practical AI music playbooks</p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            
            <!-- Doc 1 -->
