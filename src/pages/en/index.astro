---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="The 1st North American Chinese AI Music Creation & Creativity Contest 2026–2027" description="Co-hosted by ZJUAA NC and NACUAANC. Write the stories of the Chinese Diaspora with AI." path="/">
  <div class="max-w-4xl mx-auto px-6 space-y-12">
    <!-- Hero -->
    <header class="text-center py-6 space-y-4 flex flex-col items-center">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full p-1 bg-gradient-to-tr from-blue-600 via-purple-500 to-amber-400 shadow-2xl shadow-blue-500/20 mb-2">
        <img src="/images/logo.jpg" alt="ChineseMusic.AI Logo" class="w-full h-full rounded-full object-cover border-2 border-slate-950" />
      </div>
      <div class="inline-flex items-center gap-x-2 bg-blue-950/40 text-blue-400 px-4 py-1.5 rounded-full text-xs font-semibold border border-blue-900/30">
        <span class="w-1.5 h-1.5 bg-blue-400 rounded-full animate-ping"></span>
        <span>Write the Stories of the Chinese Diaspora with AI · Special Tribute to ZJU's 130th Anniversary</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-200 leading-tight mt-2">
        The 1st North American Chinese AI Music<br><span class="ai-gradient">Creation & Creativity Contest 2026–2027</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-400 text-base md:text-lg leading-relaxed">
        Open to all Chinese living in North America with no university affiliation required. Create your musical stories with AI!
      </p>
      <div class="pt-4 flex flex-wrap justify-center gap-3 md:gap-4">
        <a href="/en/register" class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold transition-all shadow-lg hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Online Registration Form</span>
        </a>
        <a href="https://luma.com/p9v0rz16" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold transition-all shadow-lg hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-video text-purple-200"></i>
          <span>8/28 Luma Kickoff (Zoom)</span>
        </a>
        <a href="#details" class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-bold transition-all hover:scale-105">
          Details
        </a>
      </div>
    </header>

    <!-- Hero Image Banner -->
    <div class="relative w-full h-56 md:h-80 rounded-3xl overflow-hidden border border-slate-900 shadow-2xl bg-slate-900 flex items-center justify-center group">
      <img src="/images/hero.jpg" alt="AI Music Banner" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 to-transparent"></div>
    </div>

    <!-- Main Content Section -->
    <div id="details" class="grid md:grid-cols-3 gap-8 pt-6">
      
      <!-- Left Column: Details -->
      <div class="md:col-span-2 space-y-10">
        
        <!-- About the Contest -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0">
              <i class="fa-solid fa-bullseye text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              About the Contest / 大赛宗旨
            </h2>
          </div>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            This competition is co-hosted by <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg bg-blue-950/90 border border-blue-500/50 text-blue-300 font-bold shadow-sm">ZJU Alumni Association of NC (ZJUAA NC)</span> and <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg bg-indigo-950/90 border border-indigo-500/50 text-indigo-300 font-bold shadow-sm">NACUAANC</span>, supported by multiple US East ZJU alumni associations, as well as NACUAA chapters in Northern California, Silicon Valley, Southern California, and other organizations.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            This is the <span class="text-sky-400 font-bold">1st AI Music Creation & Creativity Contest built specifically for the Chinese diaspora in North America</span>. We warmly welcome all Chinese residents, immigrants, international students, and friends in North America to participate, <span class="inline-block px-2 py-0.5 rounded-md bg-amber-950/70 border border-amber-500/50 text-amber-300 font-semibold">with no university affiliation required</span>.
          </p>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            Creators are encouraged to partner with AI to express Chinese stories, emotions, cultural fusion, and innovation in North America. A <span class="text-amber-300 font-bold">"Special Alma Mater Award"</span> is also established to honor Zhejiang University's 130th Anniversary.
          </p>
        </section>

        <!-- Eligibility -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm relative overflow-hidden">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 shrink-0">
              <i class="fa-solid fa-id-card text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              Eligibility / 参赛资格
            </h2>
          </div>
          <div class="grid gap-3 pt-1">
            <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 text-slate-100 text-sm font-medium">
              <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
              <span>Chinese residents, immigrants, students, and friends living in North America</span>
            </div>
            <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 text-slate-100 text-sm font-medium">
              <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
              <span>No age limit, no university affiliation required (Open to all)</span>
            </div>
            <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 text-slate-100 text-sm font-medium">
              <i class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
              <span>Individual solo entries or team collaborative submissions welcome</span>
            </div>
          </div>
        </section>

        <!-- Structure -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0">
              <i class="fa-solid fa-sitemap text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              Contest Structure (3 Stages · 8 Hubs)
            </h2>
          </div>
          <div class="grid sm:grid-cols-3 gap-4 pt-1">
            <div class="bg-slate-950/80 border border-blue-900/40 p-4 rounded-2xl text-center space-y-2">
              <div class="text-blue-400 font-extrabold text-lg">Preliminaries</div>
              <div class="text-xs text-slate-300 leading-relaxed">Auditions across 8 hubs (<a href="https://nc.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">NC</a>, <a href="https://dc.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">DC</a>, <a href="https://tn.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">TN</a>, <a href="https://fl.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">FL</a>, <a href="https://pa.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">PA</a>, <a href="https://tx.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">TX</a>, <a href="https://ca.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">CA</a>, <a href="https://wa.zjuaanc.org" target="_blank" class="text-blue-400 font-semibold hover:underline">WA</a>)</div>
            </div>
            <div class="bg-slate-950/80 border border-blue-900/40 p-4 rounded-2xl text-center space-y-2">
              <div class="text-blue-400 font-extrabold text-lg">Semifinals</div>
              <div class="text-xs text-slate-300 leading-relaxed">East Alliance vs West Alliance in a major digital showdown.</div>
            </div>
            <div class="bg-slate-950/80 border border-blue-900/40 p-4 rounded-2xl text-center space-y-2">
              <div class="text-blue-400 font-extrabold text-lg">Grand Finals</div>
              <div class="text-xs text-slate-300 leading-relaxed">Finalists from both alliances compete for top awards.</div>
            </div>
          </div>
        </section>

        <!-- Categories -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400 shrink-0">
              <i class="fa-solid fa-music text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              Categories (8 Creative Directions)
            </h2>
          </div>
          <p class="text-xs text-slate-300">Creators are encouraged to blend AI music-making tools (e.g. Suno, Udio, ChatGPT) across categories:</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center pt-1">
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Poetry Writing</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Lyrics Writing</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Composition</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Arranging</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Vocals</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">A Cappella</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Instrumental</div>
            <div class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-sm font-semibold text-slate-100 shadow-sm hover:border-blue-500/50 hover:text-blue-300 transition-colors">Music Video / MV</div>
          </div>
        </section>

        <!-- Special Awards -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0">
              <i class="fa-solid fa-trophy text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              Special Awards
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <div class="bg-slate-950/80 p-4 rounded-2xl border border-slate-800 space-y-1.5 shadow-sm">
              <div class="text-sm font-bold text-amber-300 flex items-center gap-1.5">🎓 <span>Special Alma Mater Award</span></div>
              <p class="text-xs text-slate-300 leading-relaxed">Dedicated tribute to Zhejiang University's 130th Anniversary.</p>
            </div>
            <div class="bg-slate-950/80 p-4 rounded-2xl border border-slate-800 space-y-1.5 shadow-sm">
              <div class="text-sm font-bold text-blue-300 flex items-center gap-1.5">📖 <span>Best Chinese Story Award</span></div>
              <p class="text-xs text-slate-300 leading-relaxed">Profound expression of Chinese stories and emotions in North America.</p>
            </div>
            <div class="bg-slate-950/80 p-4 rounded-2xl border border-slate-800 space-y-1.5 shadow-sm">
              <div class="text-sm font-bold text-purple-300 flex items-center gap-1.5">🌐 <span>Best East-West Fusion Award</span></div>
              <p class="text-xs text-slate-300 leading-relaxed">Innovative blending of Eastern and Western musical traditions.</p>
            </div>
            <div class="bg-slate-950/80 p-4 rounded-2xl border border-slate-800 space-y-1.5 shadow-sm">
              <div class="text-sm font-bold text-emerald-300 flex items-center gap-1.5">⚡ <span>Best AI Creative Application Award</span></div>
              <p class="text-xs text-slate-300 leading-relaxed">Outstanding integration of cutting-edge AI technologies in art.</p>
            </div>
          </div>
        </section>

        <!-- Call for Sponsors & Partners -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0">
              <i class="fa-solid fa-handshake-angle text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              Call for Sponsors & Partners
            </h2>
          </div>
          <p class="text-slate-200 text-sm md:text-[15px] leading-relaxed">
            We sincerely invite enterprises, institutions, alumni, and friends across North America to participate as sponsors or co-organizers! <strong class="text-amber-300 font-semibold">All sponsorships are eligible for US 501(c)(3) non-profit tax deduction receipts (VI AI Foundation / VI AI for Good Foundation).</strong>
          </p>
          <div class="space-y-3 pt-1">
            <div class="bg-slate-950/80 border border-slate-800 border-l-4 border-l-amber-400 p-3.5 rounded-xl space-y-1">
              <div class="text-sm font-bold text-amber-300">💎 Diamond Sponsor ($5,000+)</div>
              <p class="text-xs text-slate-300 leading-relaxed">Top-tier exposure, Grand Finals title rights, prominent LOGO placement, video acknowledgment, headline homepage feature.</p>
            </div>
            <div class="bg-slate-950/80 border border-slate-800 border-l-4 border-l-slate-300 p-3.5 rounded-xl space-y-1">
              <div class="text-sm font-bold text-slate-100">⚪ Platinum Sponsor ($3,000 – $4,999)</div>
              <p class="text-xs text-slate-300 leading-relaxed">Semifinals or Finals title rights, prominent website LOGO, featured promotional materials, workshop naming rights.</p>
            </div>
            <div class="bg-slate-950/80 border border-slate-800 border-l-4 border-l-yellow-500 p-3.5 rounded-xl space-y-1">
              <div class="text-sm font-bold text-yellow-300">🟡 Gold Sponsor ($1,500 – $2,999)</div>
              <p class="text-xs text-slate-300 leading-relaxed">Regional hub title rights, website & poster LOGO, award certificate acknowledgment, social media spotlight.</p>
            </div>
            <div class="bg-slate-950/80 border border-slate-800 border-l-4 border-l-blue-400 p-3.5 rounded-xl space-y-1">
              <div class="text-sm font-bold text-blue-300">⚪ Silver Sponsor ($800 – $1,499)</div>
              <p class="text-xs text-slate-300 leading-relaxed">Website LOGO listing, promotional material mentions, winners list acknowledgment.</p>
            </div>
            <div class="bg-slate-950/80 border border-slate-800 border-l-4 border-l-amber-600 p-3.5 rounded-xl space-y-1">
              <div class="text-sm font-bold text-amber-400">🟤 Bronze Sponsor ($300 – $799)</div>
              <p class="text-xs text-slate-300 leading-relaxed">Website and acknowledgments listing, social media thanks.</p>
            </div>
          </div>
          <p class="text-xs text-slate-300 border-t border-slate-800 pt-4 leading-relaxed space-y-1">
            <span>🤝 <strong class="text-slate-100">Special In-Kind Sponsors</strong>: Product/service contributions (prizes, venue, technical support) receive equivalent sponsor benefits.</span><br>
            <span>🤝 <strong class="text-slate-100">Co-Organizers / Partner Organizations</strong>: Alumni associations and societies are warmly welcomed to co-host.</span>
          </p>
        </section>

        <!-- Organization -->
        <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-xl backdrop-blur-sm">
          <div class="flex items-center gap-x-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0">
              <i class="fa-solid fa-users text-lg"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-100">
              Organization / 组织架构
            </h2>
          </div>
          <div class="grid sm:grid-cols-2 gap-6 text-sm pt-1">
            <div class="bg-slate-950/60 border border-slate-800/80 p-4 rounded-2xl space-y-1.5">
              <div class="font-bold text-blue-300 text-sm flex items-center gap-1.5"><i class="fa-solid fa-flag text-xs"></i> Organizers / 主办单位</div>
              <div class="text-xs text-slate-300 leading-relaxed">
                ZJU Alumni Association of NC (ZJUAA NC)<br>
                NACUAANC
              </div>
            </div>
            <div class="bg-slate-950/60 border border-slate-800/80 p-4 rounded-2xl space-y-1.5">
              <div class="font-bold text-indigo-300 text-sm flex items-center gap-1.5"><i class="fa-solid fa-handshake text-xs"></i> Partners / 合作单位</div>
              <div class="text-xs text-slate-300 leading-relaxed">
                US East ZJU Alumni Associations<br>
                NACUAA NC, Silicon Valley, SC Chapters
              </div>
            </div>
            <div class="bg-slate-950/60 border border-slate-800/80 p-4 rounded-2xl space-y-1.5">
              <div class="font-bold text-emerald-300 text-sm flex items-center gap-1.5"><i class="fa-solid fa-microchip text-xs"></i> Technical & 501(c)(3) Support</div>
              <div class="text-xs text-slate-300 leading-relaxed">
                VI AI Foundation<br>
                VI AI for Good Foundation
              </div>
            </div>
            <div class="bg-slate-950/60 border border-slate-800/80 p-4 rounded-2xl space-y-1.5">
              <div class="font-bold text-amber-300 text-sm flex items-center gap-1.5"><i class="fa-solid fa-envelope text-xs"></i> Contact / 联系方式</div>
              <div class="text-xs text-slate-300 leading-relaxed space-y-1">
                <div>Official WeChat: chinesemusicai</div>
                <div>Michael WeChat: michaelhuo</div>
                <div>Official Email: <a href="mailto:info@chinesemusic.ai" class="text-blue-400 font-semibold hover:underline">info@chinesemusic.ai</a></div>
                <div>Michael Email: <a href="mailto:michael@chinesemusic.ai" class="text-blue-400 font-semibold hover:underline">michael@chinesemusic.ai</a></div>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Right Column: Timeline & Contact -->
      <div class="space-y-6">

        <!-- Luma Virtual Kickoff -->
        <div class="bg-gradient-to-br from-purple-950/40 via-slate-900/60 to-blue-950/40 border border-purple-800/40 rounded-3xl p-6 space-y-4 shadow-xl text-center backdrop-blur-sm relative overflow-hidden group">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30 text-purple-300 text-xs font-semibold">
            <i class="fa-solid fa-video text-purple-400"></i>
            <span>8/28 Virtual Kickoff & Q&A</span>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-base font-bold text-slate-100">
              Contest Overview & AI Workshop
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              August 28, 2026 (Friday) 1:00–2:00 PM PDT<br>
              <span class="text-slate-400">(4:00–5:00 PM EDT)</span>
            </p>
          </div>
          <a href="https://luma.com/p9v0rz16" target="_blank" rel="noopener noreferrer" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold transition-all shadow-md hover:scale-[1.02] flex items-center justify-center gap-2">
            <span>Register Free on Luma</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
          </a>
        </div>

        <!-- WeChat QR -->
        <div id="register" class="bg-blue-950/30 border border-blue-900/40 rounded-3xl p-6 space-y-4 shadow-xl text-center backdrop-blur-sm">
          <h3 class="text-base font-bold text-slate-100 flex items-center justify-center gap-x-2">
            <i class="fa-solid fa-qrcode text-blue-400"></i>
            <span>Scan to Join Registration Group</span>
          </h3>
          <div class="flex flex-col items-center gap-2">
            <a href="/images/wechat_match_registration_qr.jpg" target="_blank" rel="noopener noreferrer" class="group relative block overflow-hidden rounded-2xl border border-slate-800 shadow-xl transition-all duration-300 hover:scale-[1.02] hover:border-blue-500/50 hover:shadow-blue-500/10">
              <img src="/images/wechat_match_registration_qr.jpg" alt="Contest Registration WeChat QR" class="w-48 sm:w-52 max-w-full rounded-2xl object-contain mx-auto bg-slate-950" />
              <div class="absolute inset-0 bg-slate-950/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-3 py-1.5 rounded-full bg-slate-950/85 border border-blue-500/40 text-blue-300 text-xs font-semibold backdrop-blur-md flex items-center gap-1.5 shadow-lg">
                  <i class="fa-solid fa-magnifying-glass-plus"></i> View Full Image
                </span>
              </div>
            </a>
            <span class="text-xs text-slate-400 mt-1 flex items-center justify-center gap-1">
              <i class="fa-solid fa-arrow-pointer text-[10px] text-blue-400"></i> Click image to open full resolution poster
            </span>
          </div>
        </div>
        
        <!-- Key Dates -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 space-y-6 shadow-xl backdrop-blur-sm">
          <h3 class="text-lg font-bold text-slate-200 flex items-center gap-x-2">
            <i class="fa-solid fa-calendar-days text-blue-400"></i>
            <span>Key Dates / 重要时间</span>
          </h3>
          <div class="space-y-4 text-xs">
            <div class="relative pl-6 border-l border-amber-500/40 pb-2">
