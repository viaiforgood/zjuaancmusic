---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-CN" title="大赛报名管理后台 · ChineseMusic.AI Admin" description="首届北美华人AI音乐创作创意大赛报名后台管理与数据查看系统。" path="/admin">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    
    <!-- Admin Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-x-2 bg-blue-950/60 text-blue-400 px-3 py-1 rounded-full text-xs font-semibold border border-blue-900/40">
          <i class="fa-solid fa-shield-halved"></i>
          <span>组委会管理系统 / Admin Portal</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">
          大赛报名与作品管理后台
        </h1>
      </div>
      <div class="flex items-center gap-3" id="auth-actions">
        <button id="btn-export-csv" onclick="exportCSV()" class="hidden px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-md flex items-center gap-2">
          <i class="fa-solid fa-file-csv"></i>
          <span>导出 CSV 表格</span>
        </button>
        <button id="btn-refresh" onclick="loadSubmissions()" class="hidden px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-all flex items-center gap-2">
          <i class="fa-solid fa-rotate"></i>
          <span>刷新数据</span>
        </button>
      </div>
    </header>

    <!-- Login / Unlock Section (if not authenticated) -->
    <div id="login-section" class="max-w-md mx-auto my-12 bg-slate-900/90 border border-slate-800 rounded-3xl p-8 space-y-6 shadow-2xl backdrop-blur-sm text-center">
      <div class="w-14 h-14 rounded-2xl bg-blue-500/20 border border-blue-500/30 flex items-center justify-center text-blue-400 mx-auto text-2xl shadow-inner">
        <i class="fa-solid fa-lock"></i>
      </div>
      <div class="space-y-2">
        <h2 class="text-xl font-bold text-white">输入管理员密钥</h2>
        <p class="text-xs text-slate-400">请输入组委会授权的管理员访问密钥查看全部报名信息。</p>
      </div>
      <form onsubmit="handleLogin(event)" class="space-y-4 text-left">
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-slate-300">管理员密钥 / Admin Key</label>
          <input type="password" id="admin-key-input" placeholder="输入 Admin Key" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition-all shadow-lg hover:scale-[1.02] flex items-center justify-center gap-2">
          <i class="fa-solid fa-key"></i>
          <span>解锁并查看数据</span>
        </button>
        <p id="login-error" class="text-xs text-red-400 text-center hidden"></p>
      </form>
    </div>

    <!-- Dashboard Content (Visible after login) -->
    <div id="dashboard-section" class="space-y-8 hidden">
      
      <!-- Metrics Overview Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-2 shadow-sm">
          <div class="text-xs font-semibold text-slate-400 flex items-center justify-between">
            <span>总报名作品数</span>
            <i class="fa-solid fa-music text-blue-400"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono" id="metric-total">0</div>
          <div class="text-[11px] text-slate-400">全网已录入报名记录</div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-2 shadow-sm">
          <div class="text-xs font-semibold text-slate-400 flex items-center justify-between">
            <span>母校特别奖申报</span>
            <i class="fa-solid fa-graduation-cap text-amber-400"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-amber-300 font-mono" id="metric-zju">0</div>
          <div class="text-[11px] text-slate-400">致敬浙大130周年创作</div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-2 shadow-sm">
          <div class="text-xs font-semibold text-slate-400 flex items-center justify-between">
            <span>AI / 协同创作占比</span>
            <i class="fa-solid fa-robot text-purple-400"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-purple-300 font-mono" id="metric-ai">0%</div>
          <div class="text-[11px] text-slate-400" id="metric-ai-sub">AI辅助或AIGC作品</div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-2 shadow-sm">
          <div class="text-xs font-semibold text-slate-400 flex items-center justify-between">
            <span>参赛赛区覆盖</span>
            <i class="fa-solid fa-map-location-dot text-emerald-400"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-300 font-mono" id="metric-hubs">0 / 8</div>
          <div class="text-[11px] text-slate-400">北美八大分赛区活跃度</div>
        </div>
      </div>

      <!-- Filters & Search Bar -->
      <div class="bg-slate-900/90 border border-slate-800 p-4 rounded-2xl flex flex-col sm:flex-row gap-4 items-stretch sm:items-center justify-between shadow-sm">
        <div class="flex-1 relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
          <input type="text" id="search-input" oninput="applyFilters()" placeholder="搜索姓名、邮箱、微信、作品标题、城市..." class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-200 focus:outline-none focus:border-blue-500 transition-colors" />
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <select id="filter-hub" onchange="applyFilters()" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
            <option value="">全部赛区 / All Hubs</option>
            <option value="NC">北卡 (NC)</option>
            <option value="DC">华府 (DC)</option>
            <option value="TN">田纳西 (TN)</option>
            <option value="FL">佛州 (FL)</option>
            <option value="PA">宾州 (PA)</option>
            <option value="TX">德州 (TX)</option>
            <option value="CA">加州 (CA)</option>
            <option value="WA">华州 (WA)</option>
          </select>

          <select id="filter-mode" onchange="applyFilters()" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
            <option value="">全部创作形式 / All Modes</option>
            <option value="no_ai">纯人工原创 (No AI)</option>
            <option value="ai_aided">人机协同 (AI-Aided)</option>
            <option value="aigc">全流程 AI (AIGC)</option>
          </select>
        </div>
      </div>

      <!-- Submissions Table -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-slate-950/80 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
              <tr>
                <th class="py-3.5 px-4">编号 / 提交时间</th>
                <th class="py-3.5 px-4">参赛选手 / 联络</th>
                <th class="py-3.5 px-4">赛区 / 城市</th>
                <th class="py-3.5 px-4">创作形式</th>
                <th class="py-3.5 px-4">作品标题与链接</th>
                <th class="py-3.5 px-4">申报赛道 / 特别奖</th>
                <th class="py-3.5 px-4 text-center">操作</th>
              </tr>
            </thead>
            <tbody id="submissions-tbody" class="divide-y divide-slate-800/80">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
        <div id="table-empty" class="p-12 text-center text-slate-500 text-sm hidden">
          <i class="fa-solid fa-inbox text-3xl mb-2 block"></i>
          暂无匹配的报名记录
        </div>
      </div>

    </div>

    <!-- Detail Modal -->
    <div id="detail-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 space-y-6 shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <div class="space-y-1">
            <span id="modal-ref-id" class="text-xs font-mono text-blue-400 bg-blue-950/60 px-2.5 py-0.5 rounded border border-blue-900/40"></span>
            <h3 id="modal-title" class="text-lg font-bold text-white mt-1"></h3>
          </div>
          <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div id="modal-body" class="space-y-4 text-xs text-slate-300">
          <!-- Dynamic details -->
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-800">
          <button onclick="closeModal()" class="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold">
            关闭
          </button>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    let allSubmissions = [];

    // Check stored key on load
    window.addEventListener('DOMContentLoaded', () => {
      const storedKey = sessionStorage.getItem('cm_admin_key');
      if (storedKey) {
        document.getElementById('admin-key-input').value = storedKey;
        loadSubmissions(storedKey);
      }
    });

    async function handleLogin(e) {
      e.preventDefault();
      const key = document.getElementById('admin-key-input').value.trim();
      if (!key) return;
      await loadSubmissions(key);
    }

    async function loadSubmissions(providedKey) {
      const key = providedKey || sessionStorage.getItem('cm_admin_key') || document.getElementById('admin-key-input').value.trim();
      const errorEl = document.getElementById('login-error');
      errorEl.classList.add('hidden');

      try {
        const res = await fetch(`/api/admin/submissions?key=${encodeURIComponent(key)}`);
        const json = await res.json();

        if (res.ok && json.success) {
          sessionStorage.setItem('cm_admin_key', key);
          allSubmissions = json.data || [];

          document.getElementById('login-section').classList.add('hidden');
          document.getElementById('dashboard-section').classList.remove('hidden');
          document.getElementById('btn-export-csv').classList.remove('hidden');
          document.getElementById('btn-refresh').classList.remove('hidden');

          updateMetrics(allSubmissions);
          renderTable(allSubmissions);
        } else {
          errorEl.innerText = json.error || '密钥错误或未授权访问';
          errorEl.classList.remove('hidden');
        }
      } catch (err) {
        errorEl.innerText = '网络连接错误，请重试';
        errorEl.classList.remove('hidden');
      }
    }

    function updateMetrics(list) {
      document.getElementById('metric-total').innerText = list.length;
      
      const zjuCount = list.filter(s => s.is_alma_mater_award === 'yes').length;
      document.getElementById('metric-zju').innerText = zjuCount;

      const aiCount = list.filter(s => s.creation_mode === 'ai_aided' || s.creation_mode === 'aigc').length;
      const aiPercent = list.length > 0 ? Math.round((aiCount / list.length) * 100) : 0;
      document.getElementById('metric-ai').innerText = `${aiPercent}%`;
      document.getElementById('metric-ai-sub').innerText = `共 ${aiCount} 件 AI 参与作品`;

      const hubs = new Set(list.map(s => s.hub).filter(Boolean));
      document.getElementById('metric-hubs').innerText = `${hubs.size} / 8`;
    }

    function renderTable(list) {
      const tbody = document.getElementById('submissions-tbody');
      const emptyEl = document.getElementById('table-empty');

      if (!list || list.length === 0) {
        tbody.innerHTML = '';
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      tbody.innerHTML = list.map(s => {
        const modeBadge = s.creation_mode === 'no_ai' 
          ? '<span class="px-2 py-0.5 rounded bg-sky-950/80 text-sky-300 border border-sky-800/60 text-[11px] font-semibold">纯人工 No AI</span>'
          : s.creation_mode === 'aigc'
          ? '<span class="px-2 py-0.5 rounded bg-amber-950/80 text-amber-300 border border-amber-800/60 text-[11px] font-semibold">全流程 AIGC</span>'
          : '<span class="px-2 py-0.5 rounded bg-purple-950/80 text-purple-300 border border-purple-800/60 text-[11px] font-semibold">人机协同 AI-Aided</span>';

        const awardBadge = s.is_alma_mater_award === 'yes'
          ? '<span class="px-1.5 py-0.5 rounded bg-amber-950/80 text-amber-400 border border-amber-700/60 text-[10px] font-bold">🎓 母校特别奖</span>'
          : '';

        const categoriesStr = Array.isArray(s.categories) ? s.categories.join(', ') : (s.categories || '--');
        const formattedDate = s.submittedAt ? new Date(s.submittedAt).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '--';

        return `
          <tr class="hover:bg-slate-800/40 transition-colors">
            <td class="py-3 px-4">
              <div class="font-mono text-[11px] font-bold text-blue-400">${s.refId || '--'}</div>
              <div class="text-[10px] text-slate-500 mt-0.5">${formattedDate}</div>
            </td>
            <td class="py-3 px-4">
              <div class="font-semibold text-slate-100">${escapeHtml(s.name || '--')} ${s.english_name ? `<span class="text-slate-400 font-normal">(${escapeHtml(s.english_name)})</span>` : ''}</div>
              <div class="text-[11px] text-slate-400 mt-0.5 flex flex-col gap-0.5">
                <span>📧 <a href="mailto:${s.email}" class="text-blue-400 hover:underline">${escapeHtml(s.email || '')}</a></span>
                ${s.wechat ? `<span>💬 微: ${escapeHtml(s.wechat)}</span>` : ''}
              </div>
            </td>
            <td class="py-3 px-4">
              <span class="font-bold text-sky-400">${escapeHtml(s.hub || '--')} 赛区</span>
              <div class="text-[11px] text-slate-400 mt-0.5">${escapeHtml(s.city || '--')}</div>
            </td>
            <td class="py-3 px-4">
              ${modeBadge}
            </td>
            <td class="py-3 px-4 max-w-xs">
              <div class="font-semibold text-white truncate">${escapeHtml(s.work_title || '--')}</div>
              ${s.work_url ? `
                <a href="${escapeHtml(s.work_url)}" target="_blank" rel="noopener noreferrer" class="text-[11px] text-blue-400 hover:underline flex items-center gap-1 mt-0.5 truncate">
                  <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                  <span class="truncate">${escapeHtml(s.work_url)}</span>
                </a>
              ` : ''}
            </td>
            <td class="py-3 px-4 space-y-1">
              <div class="text-[11px] text-slate-300 truncate max-w-[150px]">${escapeHtml(categoriesStr)}</div>
              ${awardBadge}
            </td>
            <td class="py-3 px-4 text-center">
              <button onclick="viewDetail('${s.refId}')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
                详情
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function applyFilters() {
      const q = document.getElementById('search-input').value.toLowerCase().trim();
      const hub = document.getElementById('filter-hub').value;
      const mode = document.getElementById('filter-mode').value;

      const filtered = allSubmissions.filter(s => {
        const matchQ = !q || [
          s.name, s.english_name, s.email, s.wechat, s.work_title, s.city, s.refId
        ].some(v => v && String(v).toLowerCase().includes(q));

        const matchHub = !hub || s.hub === hub;
        const matchMode = !mode || s.creation_mode === mode;

        return matchQ && matchHub && matchMode;
      });

      renderTable(filtered);
    }

    function viewDetail(refId) {
      const item = allSubmissions.find(s => s.refId === refId);
      if (!item) return;

      document.getElementById('modal-ref-id').innerText = item.refId;
      document.getElementById('modal-title').innerText = item.work_title || '作品详情';

      const categoriesStr = Array.isArray(item.categories) ? item.categories.join(', ') : (item.categories || '--');

      document.getElementById('modal-body').innerHTML = `
        <div class="grid grid-cols-2 gap-3 bg-slate-950 p-4 rounded-xl border border-slate-800">
          <div><span class="text-slate-500">选手姓名：</span> <strong class="text-slate-100">${escapeHtml(item.name || '')}</strong> ${item.english_name ? `(${escapeHtml(item.english_name)})` : ''}</div>
          <div><span class="text-slate-500">联系邮箱：</span> <a href="mailto:${item.email}" class="text-blue-400 hover:underline">${escapeHtml(item.email || '')}</a></div>
          <div><span class="text-slate-500">微信账号：</span> <span class="text-slate-200">${escapeHtml(item.wechat || '未填')}</span></div>
          <div><span class="text-slate-500">联系电话：</span> <span class="text-slate-200">${escapeHtml(item.phone || '未填')}</span></div>
          <div><span class="text-slate-500">所在赛区/城市：</span> <span class="text-sky-300 font-bold">${escapeHtml(item.hub || '')}</span> / ${escapeHtml(item.city || '')}</div>
          <div><span class="text-slate-500">参赛形式：</span> <span class="text-slate-200">${item.participant_type === 'team' ? `团队 (${escapeHtml(item.team_name || '')})` : '个人'}</span></div>
          <div><span class="text-slate-500">浙大校友/亲友：</span> <span class="text-slate-200">${item.is_zju_affiliated === 'yes' ? '是' : '否'}</span></div>
          <div><span class="text-slate-500">母校特别奖：</span> <span class="text-amber-400 font-bold">${item.is_alma_mater_award === 'yes' ? '是 (献礼130周年)' : '否'}</span></div>
        </div>

        <div class="space-y-1.5">
          <div class="font-bold text-slate-200">作品链接：</div>
          <a href="${escapeHtml(item.work_url || '#')}" target="_blank" class="block p-3 rounded-xl bg-slate-950 border border-slate-800 text-blue-400 hover:underline font-mono text-xs break-all">
            ${escapeHtml(item.work_url || '无链接')}
          </a>
        </div>

        <div class="space-y-1.5">
          <div class="font-bold text-slate-200">申报赛道类别：</div>
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-slate-300">${escapeHtml(categoriesStr)}</div>
        </div>

        ${item.work_concept ? `
          <div class="space-y-1.5">
            <div class="font-bold text-slate-200">作品简介与创作理念：</div>
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 leading-relaxed whitespace-pre-wrap">${escapeHtml(item.work_concept)}</div>
          </div>
        ` : ''}

        ${item.bio ? `
          <div class="space-y-1.5">
            <div class="font-bold text-slate-200">自我介绍：</div>
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-slate-300">${escapeHtml(item.bio)}</div>
          </div>
        ` : ''}

        ${item.notes ? `
          <div class="space-y-1.5">
            <div class="font-bold text-slate-200">补充说明：</div>
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-slate-300">${escapeHtml(item.notes)}</div>
          </div>
        ` : ''}
      `;

      document.getElementById('detail-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('detail-modal').classList.add('hidden');
    }

    function exportCSV() {
      const key = sessionStorage.getItem('cm_admin_key') || document.getElementById('admin-key-input').value.trim();
      window.location.href = `/api/admin/submissions?key=${encodeURIComponent(key)}&format=csv`;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</BaseLayout>
